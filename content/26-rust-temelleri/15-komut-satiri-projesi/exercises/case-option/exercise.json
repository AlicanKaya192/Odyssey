{
  "id": "case-option",
  "title": {
    "tr": "Harf Seçeneği",
    "en": "The Case Option"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`line.to_lowercase().contains(&pattern.to_lowercase())`.",
      "en": "`line.to_lowercase().contains(&pattern.to_lowercase())`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn matches(pattern: &str, line: &str, ignore_case: bool) -> bool {\n    if ignore_case {\n        line.to_lowercase().contains(&pattern.to_lowercase())\n    } else {\n        line.contains(pattern)\n    }\n}\n\nfn main() {\n    println!(\"{}\", matches(\"RUST\", \"rust\", true));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn matches(pattern: &str, line: &str, ignore_case: bool) -> bool {\n    if ignore_case {\n        line.to_lowercase().contains(&pattern.to_lowercase())\n    } else {\n        line.contains(pattern)\n    }\n}\n\nfn main() {\n    println!(\"{}\", matches(\"RUST\", \"rust\", true));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert!(matches(\"RUST\", \"a rust b\", true));",
          "label": {
            "tr": "seçenek açık",
            "en": "option on"
          }
        },
        {
          "code": "assert!(!matches(\"RUST\", \"rust\", false));",
          "label": {
            "tr": "seçenek kapalı",
            "en": "option off"
          }
        },
        {
          "code": "assert!(matches(\"ru\", \"rust\", false));",
          "label": {
            "tr": "küçük harf",
            "en": "lowercase"
          }
        },
        {
          "code": "assert!(!matches(\"x\", \"rust\", true));",
          "label": {
            "tr": "yok",
            "en": "absent"
          }
        },
        {
          "code": "assert!(matches(\"rust\", \"RUST\", true));",
          "label": {
            "tr": "satır büyük harf",
            "en": "line in capitals"
          }
        }
      ]
    }
  ]
}
