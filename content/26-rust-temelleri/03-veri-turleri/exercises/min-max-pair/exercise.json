{
  "id": "min-max-pair",
  "title": {
    "tr": "Demetle Çözmek",
    "en": "Solving with a Tuple"
  },
  "difficulty": 2,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "Metot çağrısı: `a.max(b)`.",
      "en": "A method call: `a.max(b)`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn main() {\n    let pair = (17, 42);\n    let (a, b) = pair;\n    println!(\"max: {}\", a.max(b));\n    println!(\"min: {}\", a.min(b));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn main() {\n    let pair = (17, 42);\n    let (a, b) = pair;\n    println!(\"max: {}\", a.max(b));\n    println!(\"min: {}\", a.min(b));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "max: 42\nmin: 17"
    },
    {
      "type": "rust_require",
      "pattern": "let\\s*\\(\\s*a\\s*,\\s*b\\s*\\)",
      "show": "let (a, b)"
    },
    {
      "type": "rust_require",
      "pattern": "\\.max\\(",
      "show": ".max("
    },
    {
      "type": "rust_require",
      "pattern": "\\.min\\(",
      "show": ".min("
    }
  ]
}
