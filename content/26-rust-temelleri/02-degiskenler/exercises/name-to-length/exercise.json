{
  "id": "name-to-length",
  "title": {
    "tr": "Metinden Uzunluğa",
    "en": "From Text to Length"
  },
  "difficulty": 2,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "Uzunluğu `.len()` verir: `let word = word.len();`",
      "en": "`.len()` gives the length: `let word = word.len();`"
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn main() {\n    let word = \"ownership\";\n    let word = word.len();\n    println!(\"length: {word}\");\n}\n```",
      "en": "The full solution:\n\n```rust\nfn main() {\n    let word = \"ownership\";\n    let word = word.len();\n    println!(\"length: {word}\");\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "length: 9"
    },
    {
      "type": "rust_require",
      "pattern": "\\.len\\(\\)",
      "show": ".len()"
    },
    {
      "type": "rust_forbid",
      "pattern": "\\bmut\\b",
      "show": "mut"
    }
  ]
}
