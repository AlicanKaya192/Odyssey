{
  "id": "print-version",
  "title": {
    "tr": "Sürümü Yazdır",
    "en": "Print the Version"
  },
  "difficulty": 2,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "src/main.rs",
  "files": [
    {
      "name": "src/main.rs",
      "starter": "starter-src-main.{lang}.rs",
      "solution": "solution-src-main.rs"
    },
    {
      "name": "Cargo.toml",
      "readonly": true
    }
  ],
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`println!(\"tool version {}\", ...)` içine `env!` değerini ver.",
      "en": "Give the `env!` value inside `println!(\"tool version {}\", ...)`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**src/main.rs**\n\n```rust\nfn main() {\n    println!(\"tool version {}\", env!(\"CARGO_PKG_VERSION\"));\n}\n```",
      "en": "The full solution:\n\n**src/main.rs**\n\n```rust\nfn main() {\n    println!(\"tool version {}\", env!(\"CARGO_PKG_VERSION\"));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "tool version 3.4.5"
    },
    {
      "type": "rust_forbid",
      "pattern": "3\\.4\\.5",
      "show": "3.4.5"
    },
    {
      "type": "rust_require",
      "pattern": "env!",
      "show": "env!"
    }
  ]
}
