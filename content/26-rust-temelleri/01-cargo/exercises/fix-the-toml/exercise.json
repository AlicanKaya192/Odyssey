{
  "id": "fix-the-toml",
  "title": {
    "tr": "Bozuk Ayar Dosyası",
    "en": "A Broken Settings File"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "src/main.rs",
  "files": [
    {
      "name": "Cargo.toml",
      "starter": "starter-Cargo.{lang}.toml",
      "solution": "solution-Cargo.toml"
    },
    {
      "name": "src/main.rs",
      "readonly": true
    }
  ],
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "Metinler iki tırnak arasında yazılır. `name` satırına bak.",
      "en": "Text goes between two quotes. Look at the `name` line."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n```",
      "en": "The full solution:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"demo\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "demo 0.1.0"
    }
  ]
}
