{
  "id": "rename-package",
  "title": {
    "tr": "Projeye Ad Ver",
    "en": "Name the Project"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "src/main.rs",
  "files": [
    {
      "name": "Cargo.toml",
      "starter": "starter-Cargo.{lang}.toml",
      "solution": "solution-Cargo.toml"
    },
    {
      "name": "src/main.rs",
      "readonly": true
    }
  ],
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`name` ve `version` satırlarını değiştir; tırnaklar kalsın.",
      "en": "Change the `name` and `version` lines; keep the quotes."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"greeter\"\nversion = \"1.2.0\"\nedition = \"2024\"\n\n[dependencies]\n```",
      "en": "The full solution:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"greeter\"\nversion = \"1.2.0\"\nedition = \"2024\"\n\n[dependencies]\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "greeter 1.2.0"
    }
  ]
}
