{
  "id": "even-check",
  "title": {
    "tr": "Çift mi?",
    "en": "Is It Even?"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`println!(\"{a}: {}\", a % 2 == 0);`",
      "en": "`println!(\"{a}: {}\", a % 2 == 0);`"
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn main() {\n    let a = 14;\n    let b = 27;\n    println!(\"{a}: {}\", a % 2 == 0);\n    println!(\"{b}: {}\", b % 2 == 0);\n}\n```",
      "en": "The full solution:\n\n```rust\nfn main() {\n    let a = 14;\n    let b = 27;\n    println!(\"{a}: {}\", a % 2 == 0);\n    println!(\"{b}: {}\", b % 2 == 0);\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "14: true\n27: false"
    },
    {
      "type": "rust_require",
      "pattern": "%\\s*2\\s*==\\s*0",
      "show": "% 2 == 0"
    },
    {
      "type": "rust_forbid",
      "pattern": "\\b(true|false)\\b",
      "show": "true / false"
    }
  ]
}
