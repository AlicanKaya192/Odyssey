  "hints": [
    {
      "tr": "`println!(\"{:<8}{:>4}{:>8.2}\", \"tea\", 2, 3.5);`",
      "en": "`println!(\"{:<8}{:>4}{:>8.2}\", \"tea\", 2, 3.5);`"
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn main() {\n    let total = 2.0 * 3.5 + 1.0 * 12.25;\n    println!(\"{:<8}{:>4}{:>8}\", \"item\", \"qty\", \"price\");\n    println!(\"{:<8}{:>4}{:>8.2}\", \"tea\", 2, 3.5);\n    println!(\"{:<8}{:>4}{:>8.2}\", \"coffee\", 1, 12.25);\n    println!(\"{:<8}{:>4}{:>8.2}\", \"total\", \"\", total);\n}\n```",
      "en": "The full solution:\n\n```rust\nfn main() {\n    let total = 2.0 * 3.5 + 1.0 * 12.25;\n    println!(\"{:<8}{:>4}{:>8}\", \"item\", \"qty\", \"price\");\n    println!(\"{:<8}{:>4}{:>8.2}\", \"tea\", 2, 3.5);\n    println!(\"{:<8}{:>4}{:>8.2}\", \"coffee\", 1, 12.25);\n    println!(\"{:<8}{:>4}{:>8.2}\", \"total\", \"\", total);\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "item     qty   price\ntea        2    3.50\ncoffee     1   12.25\ntotal          19.25"
    },
    {
      "type": "rust_forbid",
      "pattern": "\\b19\\.25\\b",
      "show": "19.25"
    }
  ]
}
