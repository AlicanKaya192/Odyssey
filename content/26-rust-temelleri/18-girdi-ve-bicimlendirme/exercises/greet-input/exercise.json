{
  "id": "greet-input",
  "title": {
    "tr": "Selam Ver",
    "en": "Say Hello"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`io::stdin().read_line(&mut line).expect(\"could not read\");`, sonra `line.trim()`.",
      "en": "`io::stdin().read_line(&mut line).expect(\"could not read\");`, then `line.trim()`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nuse std::io;\n\nfn main() {\n    let mut line = String::new();\n    io::stdin().read_line(&mut line).expect(\"could not read\");\n    println!(\"Hello, {}!\", line.trim());\n}\n```",
      "en": "The full solution:\n\n```rust\nuse std::io;\n\nfn main() {\n    let mut line = String::new();\n    io::stdin().read_line(&mut line).expect(\"could not read\");\n    println!(\"Hello, {}!\", line.trim());\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "Ada\n",
          "stdout": "Hello, Ada!"
        },
        {
          "stdin": "  Grace  \n",
          "stdout": "Hello, Grace!"
        }
      ]
    },
    {
      "type": "rust_require",
      "pattern": "read_line",
      "show": "read_line"
    },
    {
      "type": "rust_require",
      "pattern": "\\.trim\\(\\)",
      "show": ".trim()"
    }
  ]
}
