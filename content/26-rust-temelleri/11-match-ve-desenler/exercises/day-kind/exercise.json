{
  "id": "day-kind",
  "title": {
    "tr": "Gün Türü",
    "en": "Kind of Day"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`1..=5 => ...`, `6 | 7 => ...`, `_ => ...`.",
      "en": "`1..=5 => ...`, `6 | 7 => ...`, `_ => ...`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn day_kind(day: u8) -> &'static str {\n    match day {\n        1..=5 => \"weekday\",\n        6 | 7 => \"weekend\",\n        _ => \"invalid\",\n    }\n}\n\nfn main() {\n    println!(\"{}\", day_kind(6));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn day_kind(day: u8) -> &'static str {\n    match day {\n        1..=5 => \"weekday\",\n        6 | 7 => \"weekend\",\n        _ => \"invalid\",\n    }\n}\n\nfn main() {\n    println!(\"{}\", day_kind(6));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(day_kind(1), \"weekday\");",
          "label": {
            "tr": "1",
            "en": "1"
          }
        },
        {
          "code": "assert_eq!(day_kind(5), \"weekday\");",
          "label": {
            "tr": "5",
            "en": "5"
          }
        },
        {
          "code": "assert_eq!(day_kind(7), \"weekend\");",
          "label": {
            "tr": "7",
            "en": "7"
          }
        },
        {
          "code": "assert_eq!(day_kind(0), \"invalid\");",
          "label": {
            "tr": "0",
            "en": "0"
          }
        },
        {
          "code": "assert_eq!(day_kind(9), \"invalid\");",
          "label": {
            "tr": "9",
            "en": "9"
          }
        }
      ]
    },
    {
      "type": "rust_require",
      "pattern": "\\bmatch\\b",
      "show": "match"
    },
    {
      "type": "rust_forbid",
      "pattern": "\\bif\\b",
      "show": "if"
    }
  ]
}
