{
  "id": "count-words",
  "title": {
    "tr": "Kelime Say",
    "en": "Count Words"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`split_whitespace` zaten boşlukları eler; `.count()` sayar.",
      "en": "`split_whitespace` already drops the spaces; `.count()` counts."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn word_count(text: &str) -> usize {\n    text.split_whitespace().count()\n}\n\nfn main() {\n    println!(\"{}\", word_count(\"rust is  fun\"));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn word_count(text: &str) -> usize {\n    text.split_whitespace().count()\n}\n\nfn main() {\n    println!(\"{}\", word_count(\"rust is  fun\"));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(word_count(\"rust is  fun\"), 3);",
          "label": {
            "tr": "çift boşluk",
            "en": "double space"
          }
        },
        {
          "code": "assert_eq!(word_count(\"\"), 0);",
          "label": {
            "tr": "boş",
            "en": "empty"
          }
        },
        {
          "code": "assert_eq!(word_count(\"   \"), 0);",
          "label": {
            "tr": "yalnız boşluk",
            "en": "only spaces"
          }
        },
        {
          "code": "assert_eq!(word_count(\" one \"), 1);",
          "label": {
            "tr": "tek kelime",
            "en": "one word"
          }
        }
      ]
    }
  ]
}
