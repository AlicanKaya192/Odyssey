{
  "id": "reverse-text",
  "title": {
    "tr": "Metni Ters Çevir",
    "en": "Reverse the Text"
  },
  "difficulty": 2,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`.chars().rev().collect()`; dönüş türü `collect`'e neyi toplayacağını söyler.",
      "en": "`.chars().rev().collect()`; the return type tells `collect` what to gather."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn reversed(text: &str) -> String {\n    text.chars().rev().collect()\n}\n\nfn main() {\n    println!(\"{}\", reversed(\"rust\"));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn reversed(text: &str) -> String {\n    text.chars().rev().collect()\n}\n\nfn main() {\n    println!(\"{}\", reversed(\"rust\"));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(reversed(\"rust\"), \"tsur\");",
          "label": {
            "tr": "rust",
            "en": "rust"
          }
        },
        {
          "code": "assert_eq!(reversed(\"\\u{15F}eker\"), \"reke\\u{15F}\");",
          "label": {
            "tr": "Türkçe harf",
            "en": "Turkish letter"
          }
        },
        {
          "code": "assert_eq!(reversed(\"\"), \"\");",
          "label": {
            "tr": "boş",
            "en": "empty"
          }
        }
      ]
    }
  ]
}
