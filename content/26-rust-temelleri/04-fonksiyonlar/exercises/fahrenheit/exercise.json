{
  "id": "fahrenheit",
  "title": {
    "tr": "Sıcaklık Çevirici",
    "en": "Temperature Converter"
  },
  "difficulty": 2,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "Sayılar `.0` ile yazılmalı, `9` değil `9.0`.",
      "en": "Numbers need `.0`: `9.0`, not `9`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn to_fahrenheit(celsius: f64) -> f64 {\n    celsius * 9.0 / 5.0 + 32.0\n}\n\nfn main() {\n    println!(\"{}\", to_fahrenheit(100.0));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn to_fahrenheit(celsius: f64) -> f64 {\n    celsius * 9.0 / 5.0 + 32.0\n}\n\nfn main() {\n    println!(\"{}\", to_fahrenheit(100.0));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(to_fahrenheit(100.0), 212.0);",
          "label": {
            "tr": "100 derece",
            "en": "100 degrees"
          }
        },
        {
          "code": "assert_eq!(to_fahrenheit(0.0), 32.0);",
          "label": {
            "tr": "0 derece",
            "en": "0 degrees"
          }
        },
        {
          "code": "assert_eq!(to_fahrenheit(-40.0), -40.0);",
          "label": {
            "tr": "-40 derece",
            "en": "-40 degrees"
          }
        }
      ]
    }
  ]
}
