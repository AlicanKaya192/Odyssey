  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`hashlib` bayt ister: `text.encode()`.",
      "en": "`hashlib` wants bytes: `text.encode()`."
    },
    {
      "tr": "`hashlib.sha256(text.encode()).hexdigest()[:12]`.",
      "en": "`hashlib.sha256(text.encode()).hexdigest()[:12]`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport hashlib\n\n\ndef fingerprint(text):\n    return hashlib.sha256(text.encode()).hexdigest()[:12]\n\nprint(fingerprint(\"hello\"))\nprint(fingerprint(\"hello.\"))\n```",
      "en": "The full solution:\n\n```python\nimport hashlib\n\n\ndef fingerprint(text):\n    return hashlib.sha256(text.encode()).hexdigest()[:12]\n\nprint(fingerprint(\"hello\"))\nprint(fingerprint(\"hello.\"))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "fingerprint",
      "cases": [
        {
          "args": [
            "hello"
          ],
          "returns": "2cf24dba5fb0"
        },
        {
          "args": [
            "hello."
          ],
          "returns": "1589999b0ca6"
        },
        {
          "args": [
            ""
          ],
          "returns": "e3b0c44298fc"
        },
        {
          "args": [
            "Odyssey"
          ],
          "returns": "29215b5404a6"
        }
      ]
    },
    {
