    "tr": "Adla selam",
    "en": "A greeting by name"
  },
  "difficulty": 1,
  "language": "python",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "main.py",
  "files": [
    {
      "name": "main.py",
      "starter": "starter-main.{lang}.py",
      "solution": "solution-main.py"
    }
  ],
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`@app.get(\"/hello/{name}\")` ve `def hello(name: str):`.",
      "en": "`@app.get(\"/hello/{name}\")` and `def hello(name: str):`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**main.py**\n\n```python\nfrom fastapi import FastAPI\n\napp = FastAPI()\n\n\n@app.get(\"/hello/{name}\")\ndef hello(name: str):\n    return {\"greeting\": \"Hello, \" + name}\n```",
      "en": "The full solution:\n\n**main.py**\n\n```python\nfrom fastapi import FastAPI\n\napp = FastAPI()\n\n\n@app.get(\"/hello/{name}\")\ndef hello(name: str):\n    return {\"greeting\": \"Hello, \" + name}\n```"
    }
  ],
  "checks": [
    {
      "type": "http",
      "steps": [
        {
          "method": "GET",
          "path": "/hello/Ada",
          "expect": {
            "status": 200,
            "json": {
              "greeting": "Hello, Ada"
            }
          }
        },
        {
          "method": "GET",
          "path": "/hello/Ada%20Lovelace",
          "expect": {
            "status": 200,
            "json": {
              "greeting": "Hello, Ada Lovelace"
            }
          }
        }
      ]
    }
  ]
}
