  "timeout_sec": 30,
  "hints": [
    {
      "tr": "Bir kümede aramak için `in`.",
      "en": "Use `in` to search a set."
    },
    {
      "tr": "`return name in sys.stdlib_module_names`.",
      "en": "`return name in sys.stdlib_module_names`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport sys\n\n\ndef is_standard(name):\n    return name in sys.stdlib_module_names\n\nfor name in (\"json\", \"csv\", \"numpy\", \"requests\"):\n    print(name, is_standard(name))\n```",
      "en": "The full solution:\n\n```python\nimport sys\n\n\ndef is_standard(name):\n    return name in sys.stdlib_module_names\n\nfor name in (\"json\", \"csv\", \"numpy\", \"requests\"):\n    print(name, is_standard(name))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "is_standard",
      "cases": [
        {
          "args": [
            "json"
          ],
          "returns": true
        },
        {
          "args": [
            "csv"
          ],
          "returns": true
        },
        {
          "args": [
            "numpy"
          ],
          "returns": false
        },
        {
          "args": [
            "requests"
          ],
          "returns": false
        },
        {
          "args": [
            "math"
          ],
          "returns": true
        }
      ]
    },
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "json True\ncsv True\nnumpy False\nrequests False"
    }
  ]
}
