{
  "id": "almost-equal",
  "title": {
    "tr": "Güvenli karşılaştırma",
    "en": "Safe comparison"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`==` ondalıklarda yanıltır.",
      "en": "`==` misleads with decimals."
    },
    {
      "tr": "`return math.isclose(a, b, abs_tol=1e-9)`.",
      "en": "`return math.isclose(a, b, abs_tol=1e-9)`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport math\n\n\ndef almost_equal(a, b):\n    return math.isclose(a, b, abs_tol=1e-9)\n\nprint(almost_equal(0.1 + 0.2, 0.3))\nprint(almost_equal(1e-10, 0))\nprint(almost_equal(1.0, 1.1))\n```",
      "en": "The full solution:\n\n```python\nimport math\n\n\ndef almost_equal(a, b):\n    return math.isclose(a, b, abs_tol=1e-9)\n\nprint(almost_equal(0.1 + 0.2, 0.3))\nprint(almost_equal(1e-10, 0))\nprint(almost_equal(1.0, 1.1))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "almost_equal",
      "cases": [
        {
          "args": [
            0.30000000000000004,
            0.3
          ],
          "returns": true
        },
        {
          "args": [
            1e-10,
            0
          ],
          "returns": true
        },
        {
          "args": [
            1.0,
            1.1
          ],
          "returns": false
        },
        {
          "args": [
            100.0,
            100.0000000001
          ],
          "returns": true
        }
      ]
    },
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "True\nTrue\nFalse"
    }
  ]
}
