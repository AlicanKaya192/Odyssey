{
  "id": "make-it-runnable",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Çalıştırılabilir yap",
    "en": "Make it runnable"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir scripts private",
    {
      "write": {
        "notes.txt": "Buy milk\n",
        "shared.txt": "Team plan\n",
        "private/secret.txt": "the plan\n",
        "scripts/hello.sh": "#!/bin/bash\necho Hello from a script\n"
      }
    }
  ],
  "solution": [
    "chmod +x scripts/hello.sh",
    "./scripts/hello.sh"
  ],
  "hints": [
    {
      "tr": "İzin ekleyen komut `chmod`; çalıştırma izni `+x`.",
      "en": "The command that adds permissions is `chmod`; execute is `+x`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nchmod +x scripts/hello.sh\n./scripts/hello.sh\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nchmod +x scripts/hello.sh\n./scripts/hello.sh\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "executable": [
        "scripts/hello.sh"
      ],
      "label": {
        "tr": "hello.sh çalıştırılabilir",
        "en": "hello.sh is executable"
      }
    },
    {
      "type": "shell_state",
      "output": {
        "text": "Hello from a script",
        "command": "^\\./scripts/hello\\.sh$"
      },
      "label": {
        "tr": "./scripts/hello.sh çalıştı",
        "en": "./scripts/hello.sh ran"
      }
    }
  ]
}
