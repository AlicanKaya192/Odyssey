  "title": {
    "tr": "Salt okunur not",
    "en": "Read-only notes"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir scripts private",
    {
      "write": {
        "notes.txt": "Buy milk\n",
        "shared.txt": "Team plan\n",
        "private/secret.txt": "the plan\n",
        "scripts/hello.sh": "#!/bin/bash\necho Hello from a script\n"
      }
    }
  ],
  "solution": [
    "chmod 444 notes.txt"
  ],
  "hints": [
    {
      "tr": "Ya sayıyla (`r--` = 4) ya da harfle: herkesten yazmayı kaldır, `a-w`.",
      "en": "Either with numbers (`r--` = 4) or with letters: remove write from everyone, `a-w`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nchmod 444 notes.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nchmod 444 notes.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "modes": {
        "notes.txt": "444"
      },
      "label": {
        "tr": "notes.txt: r--r--r-- (444)",
