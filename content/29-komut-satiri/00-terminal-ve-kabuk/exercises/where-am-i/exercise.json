{
  "id": "where-am-i",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Neredeyim?",
    "en": "Where am I?"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "mkdir projects",
    "touch todo.txt",
    "touch notes/plan.txt",
    "touch notes/.draft"
  ],
  "solution": [
    "pwd",
    "ls"
  ],
  "hints": [
    {
      "tr": "Tam yol için `pwd`, listelemek için `ls`.",
      "en": "`pwd` for the full path, `ls` to list."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\npwd\nls\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\npwd\nls\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "text": "/home/ada",
        "command": "^pwd\\s*$"
      },
      "label": {
        "tr": "Bulunduğun yerin tam yolunu yazdırdın",
        "en": "You printed the full path of where you are"
      }
    },
    {
      "type": "shell_state",
      "output": {
        "pattern": "\\bnotes/",
        "command": "^ls\\b"
      },
      "label": {
        "tr": "Klasördekileri listeledin",
        "en": "You listed what is in the folder"
      }
    }
  ]
}
