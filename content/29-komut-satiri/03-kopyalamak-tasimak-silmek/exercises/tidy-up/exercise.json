{
  "id": "tidy-up",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Temizlik",
    "en": "Clean up"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/cache/img",
    "touch project/cache/a.tmp project/cache/img/b.tmp",
    "echo \"print(1)\" > project/main.py",
    "touch project/old.txt"
  ],
  "solution": [
    "ls project",
    "rm project/old.txt",
    "rm -r project/cache"
  ],
  "hints": [
    {
      "tr": "Dosya için `rm`, içi dolu klasör için `rm -r`.",
      "en": "`rm` for a file, `rm -r` for a folder with things in it."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls project\nrm project/old.txt\nrm -r project/cache\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls project\nrm project/old.txt\nrm -r project/cache\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "missing": [
        "project/old.txt"
      ],
      "label": {
        "tr": "old.txt silindi",
        "en": "old.txt is deleted"
      }
    },
    {
      "type": "shell_state",
      "missing": [
        "project/cache"
      ],
      "label": {
        "tr": "cache klasörü silindi",
        "en": "The cache folder is deleted"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "project/main.py": "print(1)"
      },
      "label": {
        "tr": "main.py yerinde",
        "en": "main.py is still there"
      }
    }
  ]
}
