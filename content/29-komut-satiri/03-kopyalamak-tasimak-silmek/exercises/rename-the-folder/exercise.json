{
  "id": "rename-the-folder",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Klasörün adını değiştir",
    "en": "Rename the folder"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir draft",
    "echo \"Chapter 1\" > draft/chapter1.txt"
  ],
  "solution": [
    "mv draft final"
  ],
  "hints": [
    {
      "tr": "Yeniden adlandırmak da taşımaktır; klasör için seçenek gerekmez.",
      "en": "Renaming is moving too; a folder needs no option."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nmv draft final\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nmv draft final\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "final/chapter1.txt": "Chapter 1"
      },
      "label": {
        "tr": "final/chapter1.txt var",
        "en": "final/chapter1.txt exists"
      }
    },
    {
      "type": "shell_state",
      "missing": [
        "draft"
      ],
      "label": {
        "tr": "draft artık yok",
        "en": "draft is gone"
      }
    }
  ]
}
