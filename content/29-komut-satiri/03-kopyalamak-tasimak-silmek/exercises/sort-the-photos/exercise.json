{
  "id": "sort-the-photos",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Fotoğrafları yerleştir",
    "en": "Put the photos away"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "touch beach.jpg cat.jpg notes.txt"
  ],
  "solution": [
    "mkdir photos",
    "mv beach.jpg cat.jpg photos/"
  ],
  "hints": [
    {
      "tr": "`mv` birden çok kaynak alabilir; son argüman hedef klasördür.",
      "en": "`mv` can take several sources; the last argument is the target folder."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nmkdir photos\nmv beach.jpg cat.jpg photos/\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nmkdir photos\nmv beach.jpg cat.jpg photos/\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "photos/beach.jpg": null,
        "photos/cat.jpg": null
      },
      "missing": [
        "beach.jpg",
        "cat.jpg"
      ],
      "label": {
        "tr": "İki fotoğraf photos klasöründe",
        "en": "Both photos are in photos"
      }
    },
    {
      "type": "shell_state",
      "command": "^mv\\s+\\S+\\s+\\S+\\s+photos/?$",
      "show": "mv beach.jpg cat.jpg photos/",
      "label": {
        "tr": "Tek bir mv ile taşıdın",
        "en": "You moved them with one mv"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "notes.txt": null
      },
      "label": {
        "tr": "notes.txt yerinde",
        "en": "notes.txt is still there"
      }
    }
  ]
}
