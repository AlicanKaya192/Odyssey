{
  "id": "copy-the-site",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Sitenin yedeği",
    "en": "A backup of the site"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p site/css",
    "echo \"Home\" > site/index.html",
    "echo \"body {}\" > site/css/style.css"
  ],
  "solution": [
    "cp -r site site-backup"
  ],
  "hints": [
    {
      "tr": "Klasör kopyalamak için `cp`'ye içindekilerle birlikte demen gerekir.",
      "en": "To copy a folder you must tell `cp` to take everything inside."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncp -r site site-backup\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncp -r site site-backup\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "site-backup/index.html": "Home",
        "site-backup/css/style.css": "body {}"
      },
      "label": {
        "tr": "site-backup içinde index.html ve css/style.css",
        "en": "site-backup has index.html and css/style.css"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "site/index.html": "Home"
      },
      "label": {
        "tr": "site yerinde",
        "en": "site is still there"
      }
    }
  ]
}
