{
  "id": "make-a-backup",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Yedek al",
    "en": "Make a backup"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "echo \"Buy milk\" > notes/todo.txt",
    "echo \"Ideas\" > notes/ideas.txt"
  ],
  "cwd": "notes",
  "solution": [
    "cp todo.txt todo.bak"
  ],
  "hints": [
    {
      "tr": "Kopyalama `cp KAYNAK HEDEF`.",
      "en": "Copying is `cp SOURCE TARGET`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncp todo.txt todo.bak\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncp todo.txt todo.bak\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "notes/todo.bak": "Buy milk"
      },
      "label": {
        "tr": "notes/todo.bak: Buy milk",
        "en": "notes/todo.bak: Buy milk"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "notes/todo.txt": "Buy milk"
      },
      "label": {
        "tr": "todo.txt yerinde",
        "en": "todo.txt is still there"
      }
    }
  ]
}
