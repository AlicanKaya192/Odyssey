{
  "id": "only-text-files",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Yalnızca metin dosyaları",
    "en": "Only the text files"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir work",
    "touch work/report.txt work/notes.txt work/data.csv work/photo1.jpg work/photo2.jpg",
    "touch work/photo10.jpg work/.hidden.txt"
  ],
  "cwd": "work",
  "solution": [
    "ls *.txt"
  ],
  "hints": [
    {
      "tr": "`*` her şeyle eşleşir; ardından uzantıyı yaz.",
      "en": "`*` matches anything; write the extension after it."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls *.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls *.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "text": "notes.txt  report.txt",
        "command": "^ls\\s+\\*\\.txt$"
      },
      "label": {
        "tr": "Yalnızca .txt dosyaları listelendi",
        "en": "Only the .txt files are listed"
      }
    }
  ]
}
