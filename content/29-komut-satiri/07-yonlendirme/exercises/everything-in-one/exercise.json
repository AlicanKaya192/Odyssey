{
  "id": "everything-in-one",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Hepsi tek dosyada",
    "en": "Everything in one file"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "echo \"Buy milk\" > notes/todo.txt",
    "touch notes/ideas.txt",
    {
      "write": {
        "names.txt": "grace\nada\nlinus\nalan\n"
      }
    }
  ],
  "allow_fail": [
    0
  ],
  "solution": [
    "ls notes/todo.txt missing > all.txt 2>&1"
  ],
  "hints": [
    {
      "tr": "Önce stdout'u dosyaya gönder, sonra stderr'i stdout'un gittiği yere: `> dosya 2>&1`.",
      "en": "First send stdout to the file, then stderr to where stdout goes: `> file 2>&1`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls notes/todo.txt missing > all.txt 2>&1\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls notes/todo.txt missing > all.txt 2>&1\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "file_match": {
        "all.txt": "cannot access 'missing'"
      },
      "label": {
        "tr": "all.txt'de hata mesajı var",
        "en": "all.txt has the error message"
      }
    },
    {
      "type": "shell_state",
      "file_match": {
        "all.txt": "^notes/todo\\.txt$"
      },
      "label": {
        "tr": "all.txt'de dosyanın adı var",
        "en": "all.txt has the file name"
      }
    }
  ]
}
