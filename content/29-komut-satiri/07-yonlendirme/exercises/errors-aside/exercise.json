{
  "id": "errors-aside",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Hataları ayır",
    "en": "Put the errors aside"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "echo \"Buy milk\" > notes/todo.txt",
    "touch notes/ideas.txt",
    {
      "write": {
        "names.txt": "grace\nada\nlinus\nalan\n"
      }
    }
  ],
  "allow_fail": [
    0
  ],
  "solution": [
    "ls notes missing 2> errors.txt"
  ],
  "hints": [
    {
      "tr": "Hata akışının numarası 2.",
      "en": "The number of the error stream is 2."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls notes missing 2> errors.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls notes missing 2> errors.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "errors.txt": "ls: cannot access 'missing': No such file or directory"
      },
      "label": {
        "tr": "errors.txt yalnızca hata mesajını taşıyor",
        "en": "errors.txt holds only the error message"
      }
    },
    {
      "type": "shell_state",
      "output": {
        "pattern": "todo\\.txt",
        "command": "^ls\\s+notes\\s+missing\\s+2>"
      },
      "label": {
        "tr": "Liste ekranda kaldı",
        "en": "The listing stayed on the screen"
      }
    }
  ]
}
