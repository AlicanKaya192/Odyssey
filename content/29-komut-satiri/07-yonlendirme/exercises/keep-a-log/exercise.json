{
  "id": "keep-a-log",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Kayıt tut",
    "en": "Keep a log"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "echo \"Buy milk\" > notes/todo.txt",
    "touch notes/ideas.txt",
    {
      "write": {
        "names.txt": "grace\nada\nlinus\nalan\n"
      }
    }
  ],
  "solution": [
    "echo \"backup started\" > backup.log",
    "echo \"backup finished\" >> backup.log"
  ],
  "hints": [
    {
      "tr": "İlk satır `>`, ikinci satır `>>` ile.",
      "en": "The first line with `>`, the second with `>>`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\necho \"backup started\" > backup.log\necho \"backup finished\" >> backup.log\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\necho \"backup started\" > backup.log\necho \"backup finished\" >> backup.log\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "backup.log": "backup started\nbackup finished"
      },
      "label": {
        "tr": "backup.log iki satır",
        "en": "backup.log has two lines"
      }
    }
  ]
}
