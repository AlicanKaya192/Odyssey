{
  "id": "the-whole-tree",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Bütün ağaç",
    "en": "The whole tree"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/src project/docs",
    "seq 100 > project/report.txt",
    "seq 100000 > project/data.csv",
    "echo \"print(1)\" > project/src/main.py",
    "echo \"# Docs\" > project/docs/readme.md",
    "echo \"KEY=1\" > project/.env",
    "touch project/notes.txt"
  ],
  "solution": [
    "ls -R project"
  ],
  "hints": [
    {
      "tr": "İç içe her şey: recursive. Bu seçenek büyük harf.",
      "en": "Everything nested: recursive. This option is a capital letter."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls -R project\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls -R project\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "^project/src:$",
        "command": "^ls\\s+-\\w*R\\w*\\s+project/?$"
      },
      "label": {
        "tr": "project ve alt klasörleri listelendi",
        "en": "project and its subfolders are listed"
      }
    }
  ]
}
