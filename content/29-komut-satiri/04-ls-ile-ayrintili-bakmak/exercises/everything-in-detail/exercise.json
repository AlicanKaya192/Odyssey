{
  "id": "everything-in-detail",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Gizliler dahil, ayrıntılı",
    "en": "Hidden ones too, in detail"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/src project/docs",
    "seq 100 > project/report.txt",
    "seq 100000 > project/data.csv",
    "echo \"print(1)\" > project/src/main.py",
    "echo \"# Docs\" > project/docs/readme.md",
    "echo \"KEY=1\" > project/.env",
    "touch project/notes.txt"
  ],
  "cwd": "project",
  "solution": [
    "ls -la"
  ],
  "hints": [
    {
      "tr": "İki seçeneği tek tirenin arkasına yan yana yaz.",
      "en": "Write the two options side by side after a single dash."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls -la\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls -la\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "^-rw-r--r-- .* \\.env$",
        "command": "^ls\\s+-\\w*(la|al)\\w*\\b"
      },
      "label": {
        "tr": ".env ayrıntılı listede görünüyor",
        "en": ".env shows up in the detailed list"
      }
    }
  ]
}
