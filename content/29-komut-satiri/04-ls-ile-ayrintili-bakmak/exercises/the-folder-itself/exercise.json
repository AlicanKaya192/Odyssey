{
  "id": "the-folder-itself",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Klasörün kendisi",
    "en": "The folder itself"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/src project/docs",
    "seq 100 > project/report.txt",
    "seq 100000 > project/data.csv",
    "echo \"print(1)\" > project/src/main.py",
    "echo \"# Docs\" > project/docs/readme.md",
    "echo \"KEY=1\" > project/.env",
    "touch project/notes.txt"
  ],
  "solution": [
    "ls -ld project/src"
  ],
  "hints": [
    {
      "tr": "`-l`'ye klasörün kendisini (directory) gösteren seçeneği ekle.",
      "en": "Add the option that shows the folder (directory) itself to `-l`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls -ld project/src\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls -ld project/src\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "^drwxr-xr-x .* project/src/$",
        "command": "^ls\\s+-\\w*d"
      },
      "label": {
        "tr": "Klasörün kendi satırını gördün",
        "en": "You saw the folder's own line"
      }
    }
  ]
}
