{
  "id": "biggest-file",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "En büyük dosya",
    "en": "The biggest file"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/src project/docs",
    "seq 100 > project/report.txt",
    "seq 100000 > project/data.csv",
    "echo \"print(1)\" > project/src/main.py",
    "echo \"# Docs\" > project/docs/readme.md",
    "echo \"KEY=1\" > project/.env",
    "touch project/notes.txt"
  ],
  "cwd": "project",
  "solution": [
    "ls -lh",
    "echo data.csv > answer.txt"
  ],
  "hints": [
    {
      "tr": "`-l` ile `-h`'yi birleştir; boyut sütunu adın hemen solunda, tarihten önce.",
      "en": "Combine `-l` and `-h`; the size column is just before the date, left of the name."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls -lh\necho data.csv > answer.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls -lh\necho data.csv > answer.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "\\d+(\\.\\d)?K .* data\\.csv$",
        "command": "^ls\\s+-\\w*(lh|hl)\\w*"
      },
      "label": {
        "tr": "Boyutlara ls -lh ile baktın",
        "en": "You looked at the sizes with ls -lh"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "project/answer.txt": "data.csv"
      },
      "label": {
        "tr": "answer.txt doğru dosyanın adı",
        "en": "answer.txt holds the right file name"
      }
    }
  ]
}
