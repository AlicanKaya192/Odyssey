{
  "id": "long-listing",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Ayrıntılı liste",
    "en": "A detailed list"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p project/src project/docs",
    "seq 100 > project/report.txt",
    "seq 100000 > project/data.csv",
    "echo \"print(1)\" > project/src/main.py",
    "echo \"# Docs\" > project/docs/readme.md",
    "echo \"KEY=1\" > project/.env",
    "touch project/notes.txt"
  ],
  "cwd": "project",
  "solution": [
    "ls -l"
  ],
  "hints": [
    {
      "tr": "Uzun liste seçeneği İngilizce long kelimesinin ilk harfi.",
      "en": "The long listing option is the first letter of long."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls -l\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls -l\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "^-rw-r--r-- 1 ada ada\\s+\\d+ .* report\\.txt$",
        "command": "^ls\\s+-\\w*l"
      },
      "label": {
        "tr": "ls -l ile ayrıntılı listeledin",
        "en": "You listed in detail with ls -l"
      }
    }
  ]
}
