{
  "id": "remove-empty-folder",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Boş klasörü kaldır",
    "en": "Remove the empty folder"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir old keep",
    "touch keep/plan.txt"
  ],
  "solution": [
    "ls old keep",
    "rmdir old"
  ],
  "hints": [
    {
      "tr": "Boş klasörü silen komut `mkdir`'in tersi gibi okunur: remove directory.",
      "en": "The command that removes an empty folder reads like the opposite of `mkdir`: remove directory."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls old keep\nrmdir old\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls old keep\nrmdir old\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "missing": [
        "old"
      ],
      "command": "^rmdir\\s+old/?$",
      "show": "rmdir old",
      "label": {
        "tr": "old klasörünü rmdir ile sildin",
        "en": "You removed old with rmdir"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "keep/plan.txt": null
      },
      "label": {
        "tr": "keep/plan.txt yerinde",
        "en": "keep/plan.txt is still there"
      }
    }
  ]
}
