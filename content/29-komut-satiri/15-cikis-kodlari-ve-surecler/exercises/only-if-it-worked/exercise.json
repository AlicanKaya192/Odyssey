{
  "id": "only-if-it-worked",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Yalnızca başarılıysa",
    "en": "Only if it worked"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir docs",
    "touch docs/a.md docs/b.md",
    {
      "write": {
        "names.txt": "grace\nada\nlinus\nalan\n",
        "app.log": "INFO server started\nWARN slow request\nINFO backup done\n",
        "check_file.sh": "#!/bin/bash\nif [ ! -f \"$1\" ]; then\n  echo \"missing: $1\"\n  exit 3\nfi\necho \"found: $1\"\n"
      }
    }
  ],
  "solution": [
    "mkdir build && touch build/ready.txt"
  ],
  "hints": [
    {
      "tr": "\"Yalnızca başarılıysa\" `&&` demek.",
      "en": "\"Only if it succeeds\" means `&&`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nmkdir build && touch build/ready.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nmkdir build && touch build/ready.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "files": {
        "build/ready.txt": null
      },
      "label": {
        "tr": "build/ready.txt var",
        "en": "build/ready.txt exists"
      }
    },
    {
      "type": "shell_state",
      "command": "^mkdir\\s+build\\s*&&\\s*touch",
      "show": "mkdir build && touch ...",
      "label": {
        "tr": "İki komutu && ile bağladın",
        "en": "You joined the two commands with &&"
      }
    }
  ]
}
