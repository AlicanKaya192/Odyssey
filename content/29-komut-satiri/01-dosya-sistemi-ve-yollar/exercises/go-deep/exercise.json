{
  "id": "go-deep",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Tek komutla in",
    "en": "Go down in one command"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p projects/site/css projects/api/docs notes",
    "touch projects/api/docs/routes.txt",
    "touch projects/site/index.html",
    "touch notes/todo.txt"
  ],
  "solution": [
    "cd projects/site/css"
  ],
  "hints": [
    {
      "tr": "Klasörleri `/` ile birbirine ekleyerek tek bir yol yazabilirsin.",
      "en": "You can write one path by joining the folders with `/`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncd projects/site/css\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncd projects/site/css\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "cwd": "projects/site/css",
      "label": {
        "tr": "Şu an projects/site/css klasöründesin",
        "en": "You are in projects/site/css"
      }
    },
    {
      "type": "shell_state",
      "command": "^cd\\s+\\S*projects/site/css/?$",
      "show": "cd projects/site/css",
      "label": {
        "tr": "Tek bir cd ile indin",
        "en": "You went down with a single cd"
      }
    }
  ]
}
