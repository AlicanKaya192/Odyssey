{
  "id": "climb-up",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Yukarı çık, yana geç",
    "en": "Go up, move across"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p projects/site/css projects/api/docs notes",
    "touch projects/api/docs/routes.txt",
    "touch projects/site/index.html",
    "touch notes/todo.txt",
    "cd projects/site/css"
  ],
  "solution": [
    "cd ../../api/docs"
  ],
  "hints": [
    {
      "tr": "Önce kaç kat yukarı çıkman gerektiğini say: css'ten site'a bir, site'tan projects'e iki.",
      "en": "First count how many levels up you need: one from css to site, two from site to projects."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncd ../../api/docs\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncd ../../api/docs\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "cwd": "projects/api/docs",
      "label": {
        "tr": "Şu an projects/api/docs klasöründesin",
        "en": "You are in projects/api/docs"
      }
    },
    {
      "type": "shell_state",
      "command": "^cd\\s+(\\./)?\\.\\./\\.\\./api/docs/?$",
      "show": "cd ../../api/docs",
      "label": {
        "tr": "Tek bir göreli cd ile geldin",
        "en": "You came with one relative cd"
      }
    }
  ]
}
