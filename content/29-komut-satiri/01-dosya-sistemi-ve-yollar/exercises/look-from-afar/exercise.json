{
  "id": "look-from-afar",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Uzaktan bak",
    "en": "Look from far away"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p projects/site/css projects/api/docs notes",
    "touch projects/api/docs/routes.txt",
    "touch projects/site/index.html",
    "touch notes/todo.txt",
    "cd /tmp"
  ],
  "solution": [
    "ls ~/projects/api/docs"
  ],
  "hints": [
    {
      "tr": "`ls` komutuna bir yol verirsin; `~` nerede olursan ol ev klasörün demek.",
      "en": "You give `ls` a path; `~` means your home folder wherever you are."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls ~/projects/api/docs\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls ~/projects/api/docs\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "pattern": "^routes\\.txt$",
        "command": "^ls\\s+~/projects/api/docs/?$"
      },
      "label": {
        "tr": "~ ile docs klasörünü listeledin",
        "en": "You listed docs using ~"
      }
    },
    {
      "type": "shell_state",
      "cwd": "/tmp",
      "label": {
        "tr": "Hâlâ /tmp'desin",
        "en": "You are still in /tmp"
      }
    }
  ]
}
