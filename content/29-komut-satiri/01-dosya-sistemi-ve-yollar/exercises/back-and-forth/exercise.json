{
  "id": "back-and-forth",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Git ve geri dön",
    "en": "Go and come back"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p projects/site/css projects/api/docs notes",
    "touch projects/api/docs/routes.txt",
    "touch projects/site/index.html",
    "touch notes/todo.txt"
  ],
  "solution": [
    "cd projects/api",
    "cd -"
  ],
  "hints": [
    {
      "tr": "`cd` komutuna tek bir tire (`-`) verirsen önceki klasöre döner.",
      "en": "If you give `cd` a single dash (`-`), it goes back to the previous folder."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncd projects/api\ncd -\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncd projects/api\ncd -\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "output": {
        "text": "/home/ada",
        "command": "^cd\\s+-$"
      },
      "label": {
        "tr": "cd - ile geri döndün",
        "en": "You went back with cd -"
      }
    },
    {
      "type": "shell_state",
      "cwd": "",
      "label": {
        "tr": "Şu an ev klasöründesin",
        "en": "You are in your home folder"
      }
    }
  ]
}
