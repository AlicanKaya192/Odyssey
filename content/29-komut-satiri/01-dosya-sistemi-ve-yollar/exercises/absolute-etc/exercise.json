{
  "id": "absolute-etc",
  "kind": "terminal",
  "language": "shell",
  "title": {
    "tr": "Mutlak yolla git",
    "en": "Go with an absolute path"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir -p projects/site/css projects/api/docs notes",
    "touch projects/api/docs/routes.txt",
    "touch projects/site/index.html",
    "touch notes/todo.txt",
    "cd projects/site"
  ],
  "solution": [
    "cd /etc",
    "cat hostname"
  ],
  "hints": [
    {
      "tr": "Mutlak yol `/` ile başlar. `cat dosya` dosyanın içini yazar.",
      "en": "An absolute path starts with `/`. `cat file` prints the contents of the file."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ncd /etc\ncat hostname\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ncd /etc\ncat hostname\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "cwd": "/etc",
      "command": "^cd\\s+/etc/?$",
      "show": "cd /etc",
      "label": {
        "tr": "Mutlak yolla /etc'ye gittin",
        "en": "You went to /etc with an absolute path"
      }
    },
    {
      "type": "shell_state",
      "output": {
        "text": "odyssey",
        "command": "^cat\\s+(/etc/)?hostname$"
      },
      "label": {
        "tr": "hostname dosyasını yazdırdın",
        "en": "You printed the hostname file"
      }
    }
  ]
}
