{
  "id": "parse-line",
  "title": {
    "tr": "Gömme satırını oku",
    "en": "Read an embedding line"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "Yıldızlı atama: `word, *numbers = line.split()`.",
      "en": "Starred assignment: `word, *numbers = line.split()`."
    },
    {
      "tr": "`[float(x) for x in numbers]`.",
      "en": "`[float(x) for x in numbers]`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ndef parse_line(line):\n    word, *numbers = line.split()\n    return [word, [float(x) for x in numbers]]\n\nword, numbers = parse_line(\"cat 0.1250 -0.5000 2.0000\")\nprint(word, numbers)\n```",
      "en": "The full solution:\n\n```python\ndef parse_line(line):\n    word, *numbers = line.split()\n    return [word, [float(x) for x in numbers]]\n\nword, numbers = parse_line(\"cat 0.1250 -0.5000 2.0000\")\nprint(word, numbers)\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "parse_line",
      "cases": [
        {
          "args": [
            "a 1 2"
          ],
          "returns": [
            "a",
            [
              1.0,
              2.0
            ]
          ]
        },
        {
          "args": [
            "dog -0.5"
          ],
          "returns": [
            "dog",
            [
              -0.5
            ]
          ]
        }
      ]
    },
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "cat [0.125, -0.5, 2.0]"
    }
  ]
}
