{
  "id": "word-symbols",
  "title": {
    "tr": "Kelimeyi sembollere ayır",
    "en": "Split a word into symbols"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`list(word)` harfleri verir.",
      "en": "`list(word)` gives the letters."
    },
    {
      "tr": "Sonuna `[\"</w>\"]` ekle.",
      "en": "Append `[\"</w>\"]`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ndef word_symbols(word):\n    return list(word) + [\"</w>\"]\n\nprint(word_symbols(\"cat\"))\nprint(word_symbols(\"a\"))\n```",
      "en": "The full solution:\n\n```python\ndef word_symbols(word):\n    return list(word) + [\"</w>\"]\n\nprint(word_symbols(\"cat\"))\nprint(word_symbols(\"a\"))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "word_symbols",
      "cases": [
        {
          "args": [
            "ab"
          ],
          "returns": [
            "a",
            "b",
            "</w>"
          ]
        },
        {
          "args": [
            "xyz"
          ],
          "returns": [
            "x",
            "y",
            "z",
            "</w>"
          ]
        }
      ]
    },
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "['c', 'a', 't', '</w>']\n['a', '</w>']"
    }
  ]
}
