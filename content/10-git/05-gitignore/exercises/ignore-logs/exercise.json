{
  "id": "ignore-logs",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Log dosyalarını görmezden gel",
    "en": "Ignore the log files"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir app",
    "cd app",
    "git init",
    "echo \"print(1)\" > app.py",
    "echo \"started\" > debug.log",
    "echo \"boom\" > error.log"
  ],
  "cwd": "app",
  "solution": [
    "git status -s",
    "echo \"*.log\" > .gitignore",
    "git status -s",
    "git add .",
    "git commit -m \"Add app\""
  ],
  "hints": [
    {
      "tr": "`echo \"*.log\" > .gitignore` tek satırlık bir `.gitignore` yazar. Tırnakları unutma.",
      "en": "`echo \"*.log\" > .gitignore` writes a one-line `.gitignore`. Don't forget the quotes."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit status -s\necho \"*.log\" > .gitignore\ngit status -s\ngit add .\ngit commit -m \"Add app\"\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit status -s\necho \"*.log\" > .gitignore\ngit status -s\ngit add .\ngit commit -m \"Add app\"\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "app",
      "ignored": [
        "debug.log",
        "error.log"
      ],
      "label": {
        "tr": "debug.log ve error.log görmezden geliniyor",
        "en": "debug.log and error.log are ignored"
      }
    },
    {
      "type": "git_state",
      "repo": "app",
      "head_files": {
        ".gitignore": null,
        "app.py": null
      },
      "last_message": "^Add app$",
      "show_message": "Add app",
      "label": {
        "tr": ".gitignore ve app.py commit'te",
        "en": ".gitignore and app.py are committed"
      }
    },
    {
      "type": "git_state",
      "repo": "app",
      "clean": true,
      "not_tracked": [
        "debug.log",
        "error.log"
      ],
      "label": {
        "tr": "Ağaç temiz, log'lar izlenmiyor",
        "en": "Tree clean, logs untracked"
      }
    }
  ]
}
