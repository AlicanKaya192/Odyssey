{
  "id": "which-rule",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Hangi kural?",
    "en": "Which rule?"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"# Site\" > README.md",
    "echo \"*.log\" > .gitignore",
    "echo \"tmp/\" >> .gitignore",
    "echo \"*.pdf\" >> .gitignore",
    "echo '!manual.pdf' >> .gitignore",
    "echo \"/secret.txt\" >> .gitignore",
    "mkdir reports",
    "echo \"q3\" > reports/2026.pdf",
    "echo \"help\" > manual.pdf"
  ],
  "cwd": "site",
  "solution": [
    "git check-ignore -v reports/2026.pdf",
    "echo 3 > answer.txt"
  ],
  "hints": [
    {
      "tr": "`git check-ignore -v <dosya>` çıktısı `.gitignore:<satır>:<desen>` biçiminde.",
      "en": "The output of `git check-ignore -v <file>` looks like `.gitignore:<line>:<pattern>`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit check-ignore -v reports/2026.pdf\necho 3 > answer.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit check-ignore -v reports/2026.pdf\necho 3 > answer.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git check-ignore\\b",
      "show": "git check-ignore -v",
      "label": {
        "tr": "git check-ignore ile sordun",
        "en": "You asked with git check-ignore"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "site/answer.txt": "3"
      },
      "label": {
        "tr": "answer.txt'de doğru satır",
        "en": "answer.txt holds the right line"
      }
    }
  ]
}
