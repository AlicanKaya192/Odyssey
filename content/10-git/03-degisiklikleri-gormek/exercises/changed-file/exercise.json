{
  "id": "changed-file",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Hangi dosya düzeltildi?",
    "en": "Which file was fixed?"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Home</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\"",
    "echo \"<h1>Abuot</h1>\" > about.html",
    "git add .",
    "git commit -m \"Add about page\"",
    "echo \"<h1>Contact</h1>\" > contact.html",
    "git add .",
    "git commit -m \"Add contact page\"",
    "echo \"<h1>About</h1>\" > about.html",
    "git commit -am \"Fix typo\"",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add styles\""
  ],
  "cwd": "site",
  "solution": [
    "git log --oneline",
    "git show --stat HEAD~1",
    "echo about.html > answer.txt"
  ],
  "hints": [
    {
      "tr": "`git show --stat <hash>` ya da `git log --stat` her commit'te hangi dosyaların değiştiğini gösterir.",
      "en": "`git show --stat <hash>` or `git log --stat` shows which files changed in each commit."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit log --oneline\ngit show --stat HEAD~1\necho about.html > answer.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit log --oneline\ngit show --stat HEAD~1\necho about.html > answer.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git (show|log)\\b.*(--stat|--name-only|-p\\b|HEAD~1|3a772d6)",
      "show": "git show --stat",
      "label": {
        "tr": "Commit'in dosyalarına baktın",
        "en": "You looked at the commit's files"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "site/answer.txt": "about.html"
      },
      "label": {
        "tr": "answer.txt'de doğru dosya",
        "en": "answer.txt holds the right file"
      }
    }
  ]
}
