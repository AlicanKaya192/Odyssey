{
  "id": "find-hash",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Commit'in kimliğini bul",
    "en": "Find the commit's id"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Home</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\"",
    "echo \"<h1>Abuot</h1>\" > about.html",
    "git add .",
    "git commit -m \"Add about page\"",
    "echo \"<h1>Contact</h1>\" > contact.html",
    "git add .",
    "git commit -m \"Add contact page\"",
    "echo \"<h1>About</h1>\" > about.html",
    "git commit -am \"Fix typo\"",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add styles\""
  ],
  "cwd": "site",
  "solution": [
    "git log --oneline",
    "echo 9d421d3 > answer.txt"
  ],
  "hints": [
    {
      "tr": "`git log --oneline` her commit'i kısa hash ve mesajla tek satırda gösterir.",
      "en": "`git log --oneline` shows each commit on one line with its short hash and message."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit log --oneline\necho 9d421d3 > answer.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit log --oneline\necho 9d421d3 > answer.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git log\\b",
      "show": "git log",
      "label": {
        "tr": "Geçmişe baktın",
        "en": "You looked at the history"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "site/answer.txt": "9d421d3"
      },
      "label": {
        "tr": "answer.txt'de doğru kısa hash",
        "en": "answer.txt holds the right short hash"
      }
    }
  ]
}
