{
  "id": "no-conflict",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Git halleder",
    "en": "Git handles it"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir shop",
    "cd shop",
    "git init",
    "echo \"Welcome\" > page.txt",
    "echo \"We sell books\" >> page.txt",
    "echo \"Open 9-17\" >> page.txt",
    "git add .",
    "git commit -m \"Add page\"",
    "git switch -c summer",
    "echo \"Welcome to summer!\" > page.txt",
    "echo \"We sell books\" >> page.txt",
    "echo \"Open 9-17\" >> page.txt",
    "git commit -am \"Summer greeting\"",
    "git switch main",
    "echo \"Welcome\" > page.txt",
    "echo \"We sell books\" >> page.txt",
    "echo \"Open 8-17\" >> page.txt",
    "git commit -am \"Open earlier\""
  ],
  "cwd": "shop",
  "solution": [
    "git merge summer --no-edit",
    "cat page.txt"
  ],
  "hints": [
    {
      "tr": "Farklı satırlar çakışmaz: `git merge summer --no-edit`.",
      "en": "Different lines don't conflict: `git merge summer --no-edit`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit merge summer --no-edit\ncat page.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit merge summer --no-edit\ncat page.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "shop",
      "merge_commit": true,
      "merged": [
        "summer"
      ],
      "label": {
        "tr": "summer birleştirildi",
        "en": "summer is merged"
      }
    },
    {
      "type": "git_state",
      "repo": "shop",
      "head_files": {
        "page.txt": "Welcome to summer!\nWe sell books\nOpen 8-17"
      },
      "label": {
        "tr": "page.txt iki değişikliği de taşıyor",
        "en": "page.txt carries both changes"
      }
    }
  ]
}
