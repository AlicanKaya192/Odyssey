{
  "id": "make-alias",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Kendi kısaltman",
    "en": "Your own shortcut"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Hom</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\""
  ],
  "cwd": "site",
  "solution": [
    "git config --global alias.lg \"log --oneline --graph --all\"",
    "git lg"
  ],
  "hints": [
    {
      "tr": "`git config --global alias.<ad> \"<komut>\"`; değer tırnak içinde.",
      "en": "`git config --global alias.<name> \"<command>\"`; the value in quotes."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit config --global alias.lg \"log --oneline --graph --all\"\ngit lg\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit config --global alias.lg \"log --oneline --graph --all\"\ngit lg\n```"
    }
  ],
  "checks": [
    {
      "type": "git_config",
      "global": {
        "alias.lg": "log --oneline --graph --all"
      },
      "label": {
        "tr": "alias.lg tanımlı",
        "en": "alias.lg is defined"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git lg\\b",
      "show": "git lg",
      "label": {
        "tr": "git lg ile denedin",
        "en": "You tried git lg"
      }
    }
  ]
}
