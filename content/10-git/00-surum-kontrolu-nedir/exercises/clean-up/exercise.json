{
  "id": "clean-up",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Ortalığı topla",
    "en": "Tidy up"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "cd notes",
    "echo \"draft\" > old.txt",
    "echo \"keep me\" > plan.txt",
    "mkdir tmp",
    "echo \"x\" > tmp/cache.txt",
    "cd ~"
  ],
  "cwd": "notes",
  "solution": [
    "ls",
    "rm old.txt",
    "rm -r tmp"
  ],
  "hints": [
    {
      "tr": "Dosya `rm` ile silinir. Klasör için `rm` tek başına yetmez; içindekilerle silmek için `-r` gerekir.",
      "en": "A file is deleted with `rm`. For a folder plain `rm` is not enough; `-r` deletes it with its contents."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\nls\nrm old.txt\nrm -r tmp\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\nls\nrm old.txt\nrm -r tmp\n```"
    }
  ],
  "checks": [
    {
      "type": "shell_state",
      "missing": [
        "notes/old.txt"
      ],
      "label": {
        "tr": "old.txt silindi",
        "en": "old.txt is deleted"
      }
    },
    {
      "type": "shell_state",
      "missing": [
        "notes/tmp"
      ],
      "label": {
        "tr": "tmp klasörü silindi",
        "en": "The tmp folder is deleted"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "notes/plan.txt": "keep me"
      },
      "label": {
        "tr": "plan.txt yerinde",
        "en": "plan.txt is still there"
      }
    }
  ]
}
