{
  "id": "first-repo",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "İlk depo",
    "en": "The first repository"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir recipes",
    "echo \"Pancakes\" > recipes/list.txt"
  ],
  "solution": [
    "git --version",
    "cd recipes",
    "git init",
    "ls -a"
  ],
  "hints": [
    {
      "tr": "Sürüm `git --version`, depo `git init`. Gizlileri gösteren `ls -a`.",
      "en": "The version is `git --version`, the repository is `git init`. `ls -a` shows hidden files."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit --version\ncd recipes\ngit init\nls -a\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit --version\ncd recipes\ngit init\nls -a\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git\\s+--version$",
      "show": "git --version",
      "label": {
        "tr": "Git'in sürümüne baktın",
        "en": "You checked Git's version"
      }
    },
    {
      "type": "git_state",
      "repo": "recipes",
      "label": {
        "tr": "recipes bir Git deposu",
        "en": "recipes is a Git repository"
      }
    },
    {
      "type": "git_command",
      "pattern": "^ls\\s+(-a|-la|-al)\\b",
      "show": "ls -a",
      "label": {
        "tr": "Gizli .git klasörünü gördün",
        "en": "You saw the hidden .git folder"
      }
    }
  ]
}
