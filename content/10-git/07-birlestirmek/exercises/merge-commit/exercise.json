{
  "id": "merge-commit",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Birleştirme commit'i",
    "en": "A merge commit"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Home</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\"",
    "git switch -c contact",
    "echo \"<h1>Contact</h1>\" > contact.html",
    "git add .",
    "git commit -m \"Add contact page\"",
    "git switch main",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add styles\""
  ],
  "cwd": "site",
  "solution": [
    "git log --oneline --graph --all",
    "git merge contact --no-edit",
    "git log --oneline --graph"
  ],
  "hints": [
    {
      "tr": "`git merge <dal> --no-edit` hazır mesajı kullanır.",
      "en": "`git merge <branch> --no-edit` uses the ready-made message."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit log --oneline --graph --all\ngit merge contact --no-edit\ngit log --oneline --graph\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit log --oneline --graph --all\ngit merge contact --no-edit\ngit log --oneline --graph\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "merge_commit": true,
      "last_message": "^Merge branch 'contact'$",
      "show_message": "Merge branch 'contact'",
      "label": {
        "tr": "Birleştirme commit'i: Merge branch 'contact'",
        "en": "Merge commit: Merge branch 'contact'"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "merged": [
        "contact"
      ],
      "head_files": {
        "contact.html": null,
        "style.css": null
      },
      "clean": true,
      "label": {
        "tr": "main iki dalın işini de taşıyor",
        "en": "main carries the work of both branches"
      }
    }
  ]
}
