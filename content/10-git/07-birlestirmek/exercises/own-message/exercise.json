{
  "id": "own-message",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Kendi mesajınla",
    "en": "With your own message"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Home</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\"",
    "git switch -c contact",
    "echo \"<h1>Contact</h1>\" > contact.html",
    "git add .",
    "git commit -m \"Add contact page\"",
    "git switch main",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add styles\""
  ],
  "cwd": "site",
  "solution": [
    "git merge contact -m \"Merge contact page\"",
    "git log --oneline -3"
  ],
  "hints": [
    {
      "tr": "`git merge <dal> -m \"<mesaj>\"`.",
      "en": "`git merge <branch> -m \"<message>\"`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit merge contact -m \"Merge contact page\"\ngit log --oneline -3\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit merge contact -m \"Merge contact page\"\ngit log --oneline -3\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "merge_commit": true,
      "last_message": "^Merge contact page$",
      "show_message": "Merge contact page",
      "merged": [
        "contact"
      ],
      "label": {
        "tr": "Birleştirme commit'i: Merge contact page",
        "en": "Merge commit: Merge contact page"
      }
    }
  ]
}
