{
  "id": "fast-forward",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "İleri sarma",
    "en": "Fast-forward"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Home</h1>\" > index.html",
    "git add .",
    "git commit -m \"Add home page\"",
    "git switch -c about",
    "echo \"<h1>About</h1>\" > about.html",
    "git add .",
    "git commit -m \"Add about page\"",
    "git switch main"
  ],
  "cwd": "site",
  "solution": [
    "git log --oneline --graph --all",
    "git merge about",
    "git branch -d about"
  ],
  "hints": [
    {
      "tr": "`main`'desin; `git merge about`. Silmek `git branch -d about`.",
      "en": "You are on `main`; `git merge about`. Deleting is `git branch -d about`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit log --oneline --graph --all\ngit merge about\ngit branch -d about\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit log --oneline --graph --all\ngit merge about\ngit branch -d about\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "branch": "main",
      "tips": {
        "main": "^Add about page$"
      },
      "label": {
        "tr": "main'in ucu Add about page",
        "en": "main's tip is Add about page"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "linear": true,
      "commits": 2,
      "label": {
        "tr": "Birleştirme commit'i yok, geçmiş düz",
        "en": "No merge commit, history straight"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "no_branches": [
        "about"
      ],
      "label": {
        "tr": "about dalı silindi",
        "en": "The about branch is deleted"
      }
    }
  ]
}
