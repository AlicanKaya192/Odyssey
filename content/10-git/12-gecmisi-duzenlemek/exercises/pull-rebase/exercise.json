{
  "id": "pull-rebase",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Düz bir pull",
    "en": "A straight pull"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/ada/app.git",
      "files": {
        "f.txt": "a\n"
      },
      "message": "Base",
      "author": [
        "Ada Lovelace",
        "ada@example.com"
      ]
    },
    "git clone https://github.com/ada/app.git",
    "cd app",
    "echo \"x\" > x.txt",
    "git add .",
    "git commit -m \"Add x\"",
    {
      "remote": "https://github.com/ada/app.git",
      "files": {
        "f.txt": "a\n",
        "g.txt": "g\n"
      },
      "message": "Add g",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    }
  ],
  "cwd": "app",
  "solution": [
    "git pull --rebase",
    "git push"
  ],
  "hints": [
    {
      "tr": "`git pull --rebase`, sonra `git push`.",
      "en": "`git pull --rebase`, then `git push`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit pull --rebase\ngit push\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit pull --rebase\ngit push\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "app",
      "linear": true,
      "messages": [
        "Add x",
        "Add g",
        "Base"
      ],
      "label": {
        "tr": "Düz geçmiş: Add x, Add g'nin üstünde",
        "en": "Straight history: Add x on top of Add g"
      }
    },
    {
      "type": "git_state",
      "repo": "app",
      "pushed": true,
      "remote_commits": {
        "url": "https://github.com/ada/app.git",
        "count": 3
      },
      "label": {
        "tr": "GitHub güncel",
        "en": "GitHub is up to date"
      }
    }
  ]
}
