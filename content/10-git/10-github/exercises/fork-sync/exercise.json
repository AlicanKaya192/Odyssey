{
  "id": "fork-sync",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Fork'u güncelle",
    "en": "Update the fork"
  },
  "difficulty": 3,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/grace/site.git",
      "files": {
        "index.html": "<h1>Site</h1>\n"
      },
      "message": "Add home page",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    },
    {
      "fork": "https://github.com/grace/site.git",
      "remote": "https://github.com/ada/site.git"
    },
    "git clone https://github.com/ada/site.git",
    {
      "remote": "https://github.com/grace/site.git",
      "files": {
        "index.html": "<h1>Site</h1>\n",
        "news.html": "<h1>News</h1>\n"
      },
      "message": "Add news page",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    }
  ],
  "cwd": "site",
  "solution": [
    "git remote add upstream https://github.com/grace/site.git",
    "git fetch upstream",
    "git merge upstream/main",
    "git push"
  ],
  "hints": [
    {
      "tr": "`git remote add upstream <adres>`, `git fetch upstream`, `git merge upstream/main`, `git push`.",
      "en": "`git remote add upstream <url>`, `git fetch upstream`, `git merge upstream/main`, `git push`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit remote add upstream https://github.com/grace/site.git\ngit fetch upstream\ngit merge upstream/main\ngit push\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit remote add upstream https://github.com/grace/site.git\ngit fetch upstream\ngit merge upstream/main\ngit push\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "remotes": {
        "origin": "https://github.com/ada/site.git",
        "upstream": "https://github.com/grace/site.git"
      },
      "label": {
        "tr": "origin ve upstream kayıtlı",
        "en": "origin and upstream saved"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "tips": {
        "main": "^Add news page$"
      },
      "label": {
        "tr": "main, upstream'in yeniliğini içeriyor",
        "en": "main contains upstream's update"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "pushed": true,
      "remote_commits": {
        "url": "https://github.com/ada/site.git",
        "count": 2
      },
      "label": {
        "tr": "Fork'un güncel",
        "en": "Your fork is up to date"
      }
    }
  ]
}
