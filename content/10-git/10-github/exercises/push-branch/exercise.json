{
  "id": "push-branch",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "PR için dal gönder",
    "en": "Push a branch for a PR"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/ada/site.git",
      "files": {
        "index.html": "<h1>Site</h1>\n"
      },
      "message": "Add home page",
      "author": [
        "Ada Lovelace",
        "ada@example.com"
      ]
    },
    "git clone https://github.com/ada/site.git"
  ],
  "cwd": "site",
  "solution": [
    "git switch -c contact-form",
    "echo \"<form>\" > contact.html",
    "git add .",
    "git commit -m \"Add contact form\"",
    "git push -u origin contact-form"
  ],
  "hints": [
    {
      "tr": "Yeni dal ilk kez: `git push -u origin <dal>`.",
      "en": "A new branch the first time: `git push -u origin <branch>`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit switch -c contact-form\necho \"<form>\" > contact.html\ngit add .\ngit commit -m \"Add contact form\"\ngit push -u origin contact-form\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit switch -c contact-form\necho \"<form>\" > contact.html\ngit add .\ngit commit -m \"Add contact form\"\ngit push -u origin contact-form\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "tips": {
        "contact-form": "^Add contact form$"
      },
      "label": {
        "tr": "contact-form dalında commit",
        "en": "A commit on contact-form"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "upstream": {
        "contact-form": "origin/contact-form"
      },
      "pushed": [
        "contact-form"
      ],
      "label": {
        "tr": "Dal GitHub'da, izleniyor",
        "en": "The branch is on GitHub, tracked"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "tips": {
        "main": "^Add home page$"
      },
      "label": {
        "tr": "main'e dokunulmadı",
        "en": "main is untouched"
      }
    }
  ]
}
