{
  "id": "defaults",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Varsayılanlar",
    "en": "Defaults"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [],
  "configured": false,
  "solution": [
    "git config --global init.defaultBranch main",
    "git config --global core.editor \"code --wait\"",
    "git config --global --list"
  ],
  "hints": [
    {
      "tr": "Anahtarlar `init.defaultBranch` ve `core.editor`. `code --wait` boşluk içeriyor.",
      "en": "The keys are `init.defaultBranch` and `core.editor`. `code --wait` contains a space."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit config --global init.defaultBranch main\ngit config --global core.editor \"code --wait\"\ngit config --global --list\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit config --global init.defaultBranch main\ngit config --global core.editor \"code --wait\"\ngit config --global --list\n```"
    }
  ],
  "checks": [
    {
      "type": "git_config",
      "global": {
        "init.defaultbranch": "main"
      },
      "label": {
        "tr": "init.defaultBranch: main",
        "en": "init.defaultBranch: main"
      }
    },
    {
      "type": "git_config",
      "global": {
        "core.editor": "code --wait"
      },
      "label": {
        "tr": "core.editor: code --wait",
        "en": "core.editor: code --wait"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git config (--global (--list|-l)|(--list|-l) --global)$",
      "show": "git config --global --list",
      "label": {
        "tr": "Genel ayarları listeledin",
        "en": "You listed the global settings"
      }
    }
  ]
