{
  "id": "urgent-fix",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Acil düzeltme",
    "en": "An urgent fix"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Welcom</h1>\" > index.html",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add home page\"",
    "git switch -c redesign",
    "echo \"h1 {font-size: 3em}\" >> style.css"
  ],
  "cwd": "site",
  "solution": [
    "git stash",
    "git switch main",
    "echo \"<h1>Welcome</h1>\" > index.html",
    "git commit -am \"Fix typo\"",
    "git switch redesign",
    "git stash pop"
  ],
  "hints": [
    {
      "tr": "`git stash` → dal değiştir, düzelt, commit → geri dön → `git stash pop`.",
      "en": "`git stash` → switch, fix, commit → come back → `git stash pop`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit stash\ngit switch main\necho \"<h1>Welcome</h1>\" > index.html\ngit commit -am \"Fix typo\"\ngit switch redesign\ngit stash pop\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit stash\ngit switch main\necho \"<h1>Welcome</h1>\" > index.html\ngit commit -am \"Fix typo\"\ngit switch redesign\ngit stash pop\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "tips": {
        "main": "^Fix typo$"
      },
      "label": {
        "tr": "main'de Fix typo commit'i",
        "en": "Fix typo commit on main"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "branch": "redesign",
      "stash": 0,
      "unstaged": [
        "style.css"
      ],
      "files": {
        "style.css": "body {}\nh1 {font-size: 3em}"
      },
      "label": {
        "tr": "redesign'dasın, yarım iş geri geldi",
        "en": "On redesign, the half-done work is back"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "tips": {
        "redesign": "^Add home page$"
      },
      "label": {
        "tr": "Yarım iş commit'lenmedi",
        "en": "The half-done work wasn't committed"
      }
    }
  ]
}
