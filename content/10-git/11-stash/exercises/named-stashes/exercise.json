{
  "id": "named-stashes",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Adlı stash'ler",
    "en": "Named stashes"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Welcom</h1>\" > index.html",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add home page\""
  ],
  "cwd": "site",
  "solution": [
    "echo \"h1 {color: red}\" >> style.css",
    "git stash push -m \"try red\"",
    "echo \"h1 {color: blue}\" >> style.css",
    "git stash push -m \"try blue\"",
    "git stash list"
  ],
  "hints": [
    {
      "tr": "`git stash push -m \"<ad>\"`.",
      "en": "`git stash push -m \"<name>\"`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\necho \"h1 {color: red}\" >> style.css\ngit stash push -m \"try red\"\necho \"h1 {color: blue}\" >> style.css\ngit stash push -m \"try blue\"\ngit stash list\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\necho \"h1 {color: red}\" >> style.css\ngit stash push -m \"try red\"\necho \"h1 {color: blue}\" >> style.css\ngit stash push -m \"try blue\"\ngit stash list\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "stash": 2,
      "clean": true,
      "label": {
        "tr": "İki stash kaydı, ağaç temiz",
        "en": "Two stash entries, tree clean"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git stash push -m [\"']?try red",
      "show": "git stash push -m \"try red\"",
      "label": {
        "tr": "try red adıyla kaldırdın",
        "en": "You stashed as try red"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git stash push -m [\"']?try blue",
      "show": "git stash push -m \"try blue\"",
      "label": {
        "tr": "try blue adıyla kaldırdın",
        "en": "You stashed as try blue"
      }
    }
  ]
}
