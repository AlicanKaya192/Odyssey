{
  "id": "stash-untracked",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Yeni dosyayı da kaldır",
    "en": "Put away the new file too"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Welcom</h1>\" > index.html",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add home page\"",
    "echo \"h1 {}\" >> style.css",
    "echo \"<h1>Blog</h1>\" > blog.html"
  ],
  "cwd": "site",
  "solution": [
    "git stash -u",
    "git status -s",
    "git stash list"
  ],
  "hints": [
    {
      "tr": "`-u` izlenmeyen dosyaları da alır.",
      "en": "`-u` takes untracked files too."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit stash -u\ngit status -s\ngit stash list\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit stash -u\ngit status -s\ngit stash list\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "clean": true,
      "missing_files": [
        "blog.html"
      ],
      "stash": 1,
      "label": {
        "tr": "Ağaç tamamen temiz, tek stash kaydı",
        "en": "Tree completely clean, one stash entry"
      }
    }
  ]
}
