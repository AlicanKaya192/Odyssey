      "id": "q1",
      "answer": 0,
      "text": {
        "tr": "`git stash` ne yapar?",
        "en": "What does `git stash` do?"
      },
      "options": {
        "tr": [
          "Commit'lenmemiş değişiklikleri kenara kaldırıp çalışma alanını temizler",
          "Son commit'i siler",
          "Dalı GitHub'a gönderir",
          "Dosyaları sıkıştırır"
        ],
        "en": [
          "Puts uncommitted changes aside and cleans the working tree",
          "Deletes the last commit",
          "Pushes the branch",
          "Compresses files"
        ]
      },
      "explanation": {
        "tr": "Sonra geri getirilir.",
        "en": "Brought back later."
      }
    },
