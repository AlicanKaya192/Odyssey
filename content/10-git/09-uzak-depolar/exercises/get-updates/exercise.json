{
  "id": "get-updates",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Yenilikleri al",
    "en": "Get the updates"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n"
      },
      "message": "Add soup",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    },
    "git clone https://github.com/grace/recipes.git",
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n",
        "bread.txt": "flour\nwater\n"
      },
      "message": "Add bread recipe",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    },
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n",
        "bread.txt": "flour\nwater\nsalt\n"
      },
      "message": "Salt the bread",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    }
  ],
  "cwd": "recipes",
  "solution": [
    "git fetch",
    "git status",
    "git pull"
  ],
  "hints": [
    {
      "tr": "`git fetch` haber getirir, `git pull` alır.",
      "en": "`git fetch` brings news, `git pull` takes."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit fetch\ngit status\ngit pull\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit fetch\ngit status\ngit pull\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git fetch\\b",
      "show": "git fetch",
      "label": {
        "tr": "Önce git fetch ile baktın",
        "en": "You looked first with git fetch"
      }
    },
    {
      "type": "git_state",
      "repo": "recipes",
      "same_as": "origin/main",
      "tips": {
        "main": "^Salt the bread$"
      },
      "label": {
        "tr": "main, GitHub'daki son commit'te",
        "en": "main is at the latest commit on GitHub"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "recipes/bread.txt": "flour\nwater\nsalt"
      },
      "label": {
        "tr": "bread.txt bilgisayarında",
        "en": "bread.txt is on your computer"
      }
    }
  ]
}
