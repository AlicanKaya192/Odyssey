{
  "id": "rejected-push",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Reddedilen gönderim",
    "en": "A refused push"
  },
  "difficulty": 3,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n"
      },
      "message": "Add soup",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    },
    "git clone https://github.com/grace/recipes.git",
    "cd recipes",
    "echo \"salt\" >> soup.txt",
    "git commit -am \"Add salt\"",
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n",
        "bread.txt": "flour\nwater\n"
      },
      "message": "Add bread recipe",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    }
  ],
  "cwd": "recipes",
  "allow_fail": [
    0
  ],
  "solution": [
    "git push",
    "git pull --no-rebase --no-edit",
    "git push"
  ],
  "hints": [
    {
      "tr": "`git pull --no-rebase --no-edit` birleştirmeyle alır; ardından `git push`.",
      "en": "`git pull --no-rebase --no-edit` takes it with a merge; then `git push`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit push\ngit pull --no-rebase --no-edit\ngit push\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit push\ngit pull --no-rebase --no-edit\ngit push\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "recipes",
      "merged": [
        "origin/main"
      ],
      "merge_commit": true,
      "label": {
        "tr": "Grace'in commit'i birleştirildi",
        "en": "Grace's commit is merged"
      }
    },
    {
      "type": "git_state",
      "repo": "recipes",
      "pushed": true,
      "remote_commits": {
        "url": "https://github.com/grace/recipes.git",
        "count": 4
      },
      "label": {
        "tr": "Hepsi GitHub'da",
        "en": "Everything is on GitHub"
      }
    }
  ]
}
