{
  "id": "send-change",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Değişikliği gönder",
    "en": "Send a change"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n"
      },
      "message": "Add soup",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    },
    "git clone https://github.com/grace/recipes.git"
  ],
  "cwd": "recipes",
  "solution": [
    "echo \"pepper\" >> soup.txt",
    "git commit -am \"Add pepper\"",
    "git push"
  ],
  "hints": [
    {
      "tr": "Klonlanan depoda izleme hazır: `git push` yeter.",
      "en": "Tracking is ready in a clone: `git push` is enough."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\necho \"pepper\" >> soup.txt\ngit commit -am \"Add pepper\"\ngit push\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\necho \"pepper\" >> soup.txt\ngit commit -am \"Add pepper\"\ngit push\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "recipes",
      "last_message": "^Add pepper$",
      "show_message": "Add pepper",
      "head_files": {
        "soup.txt": "water\nonion\npepper"
      },
      "label": {
        "tr": "Add pepper commit'i",
        "en": "The Add pepper commit"
      }
    },
    {
      "type": "git_state",
      "repo": "recipes",
      "pushed": true,
      "remote_commits": {
        "url": "https://github.com/grace/recipes.git",
        "count": 2
      },
      "label": {
        "tr": "Commit GitHub'da",
        "en": "The commit is on GitHub"
      }
    }
  ]
}
