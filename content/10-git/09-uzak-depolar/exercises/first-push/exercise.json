{
  "id": "first-push",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "İlk gönderim",
    "en": "The first push"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir notes",
    "cd notes",
    "git init",
    "echo \"Buy milk\" > todo.txt",
    "git add .",
    "git commit -m \"Add todo list\"",
    "echo \"# Notes\" > readme.md",
    "git add .",
    "git commit -m \"Add readme\"",
    {
      "remote": "https://github.com/ada/notes.git"
    }
  ],
  "cwd": "notes",
  "solution": [
    "git remote add origin https://github.com/ada/notes.git",
    "git push -u origin main",
    "git status"
  ],
  "hints": [
    {
      "tr": "`git remote add origin <adres>`, sonra `git push -u origin main`. `-u` izlemeyi ayarlar.",
      "en": "`git remote add origin <url>`, then `git push -u origin main`. `-u` sets up tracking."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit remote add origin https://github.com/ada/notes.git\ngit push -u origin main\ngit status\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit remote add origin https://github.com/ada/notes.git\ngit push -u origin main\ngit status\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "notes",
      "remotes": {
        "origin": "https://github.com/ada/notes.git"
      },
      "label": {
        "tr": "origin kayıtlı",
        "en": "origin is saved"
      }
    },
    {
      "type": "git_state",
      "repo": "notes",
      "upstream": {
        "main": "origin/main"
      },
      "label": {
        "tr": "main, origin/main'i izliyor",
        "en": "main tracks origin/main"
      }
    },
    {
      "type": "git_state",
      "repo": "notes",
      "remote_commits": {
        "url": "https://github.com/ada/notes.git",
        "count": 2
      },
      "label": {
        "tr": "İki commit GitHub'da",
        "en": "Two commits on GitHub"
      }
    }
  ]
}
