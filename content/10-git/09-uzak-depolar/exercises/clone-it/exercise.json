{
  "id": "clone-it",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Depoyu indir",
    "en": "Download the repository"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/grace/recipes.git",
      "files": {
        "README.md": "# Recipes\n",
        "soup.txt": "water\nonion\n"
      },
      "message": "Add soup",
      "author": [
        "Grace Hopper",
        "grace@example.com"
      ]
    }
  ],
  "solution": [
    "git clone https://github.com/grace/recipes.git",
    "cd recipes",
    "git log --oneline",
    "git remote -v"
  ],
  "hints": [
    {
      "tr": "`git clone <adres>` adresin sonundaki adla bir klasör açar.",
      "en": "`git clone <url>` creates a folder named after the end of the address."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit clone https://github.com/grace/recipes.git\ncd recipes\ngit log --oneline\ngit remote -v\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit clone https://github.com/grace/recipes.git\ncd recipes\ngit log --oneline\ngit remote -v\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "recipes",
      "remotes": {
        "origin": "https://github.com/grace/recipes.git"
      },
      "label": {
        "tr": "recipes indirildi, origin ayarlı",
        "en": "recipes downloaded, origin set"
      }
    },
    {
      "type": "shell_state",
      "cwd": "recipes",
      "label": {
        "tr": "recipes klasöründesin",
        "en": "You are in recipes"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git log\\b",
      "show": "git log",
      "label": {
        "tr": "Geçmişe baktın",
        "en": "You looked at the history"
      }
    }
  ]
}
