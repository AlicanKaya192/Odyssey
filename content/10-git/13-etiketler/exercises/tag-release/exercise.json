{
  "id": "tag-release",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Sürümü etiketle",
    "en": "Tag the release"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir app",
    "cd app",
    "git init",
    "echo \"v1\" > app.txt",
    "git add .",
    "git commit -m \"Add prototype\"",
    "echo \"search\" >> app.txt",
    "git commit -am \"Add search\"",
    "echo \"fix\" >> app.txt",
    "git commit -am \"Fix search bug\""
  ],
  "cwd": "app",
  "solution": [
    "git tag -a v1.0 -m \"First release\"",
    "git show v1.0 --stat"
  ],
  "hints": [
    {
      "tr": "`git tag -a <ad> -m \"<mesaj>\"`.",
      "en": "`git tag -a <name> -m \"<message>\"`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit tag -a v1.0 -m \"First release\"\ngit show v1.0 --stat\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit tag -a v1.0 -m \"First release\"\ngit show v1.0 --stat\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "app",
      "annotated": [
        "v1.0"
      ],
      "tag_at": {
        "v1.0": "^Fix search bug$"
      },
      "label": {
        "tr": "v1.0 açıklamalı, son commit'te",
        "en": "v1.0 is annotated, on the last commit"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git show v1\\.0",
      "show": "git show v1.0",
      "label": {
        "tr": "Etikete baktın",
        "en": "You looked at the tag"
      }
    }
  ]
}
