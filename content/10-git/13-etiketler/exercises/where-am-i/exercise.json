{
  "id": "where-am-i",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Sürüme göre neredeyim?",
    "en": "Where am I, by version?"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir app",
    "cd app",
    "git init",
    "echo \"v1\" > app.txt",
    "git add .",
    "git commit -m \"Add prototype\"",
    "echo \"search\" >> app.txt",
    "git commit -am \"Add search\"",
    "echo \"fix\" >> app.txt",
    "git commit -am \"Fix search bug\"",
    "git tag -a v1.0 -m \"Version 1.0\" HEAD~1"
  ],
  "cwd": "app",
  "solution": [
    "git describe",
    "echo v1.0-1-g6d6d69b > answer.txt"
  ],
  "hints": [
    {
      "tr": "`git describe` çıktısını kopyala: `echo <çıktı> > answer.txt`.",
      "en": "Copy the output of `git describe`: `echo <output> > answer.txt`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit describe\necho v1.0-1-g6d6d69b > answer.txt\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit describe\necho v1.0-1-g6d6d69b > answer.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "git_command",
      "pattern": "^git describe\\b",
      "show": "git describe",
      "label": {
        "tr": "git describe ile sordun",
        "en": "You asked with git describe"
      }
    },
    {
      "type": "shell_state",
      "files": {
        "app/answer.txt": "v1.0-1-g6d6d69b"
      },
      "label": {
        "tr": "answer.txt'de doğru cevap",
        "en": "answer.txt holds the right answer"
      }
    }
  ]
}
