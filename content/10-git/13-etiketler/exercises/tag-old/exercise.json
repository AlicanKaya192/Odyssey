{
  "id": "tag-old",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Unutulan etiket",
    "en": "The forgotten tag"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir app",
    "cd app",
    "git init",
    "echo \"v1\" > app.txt",
    "git add .",
    "git commit -m \"Add prototype\"",
    "echo \"search\" >> app.txt",
    "git commit -am \"Add search\"",
    "echo \"fix\" >> app.txt",
    "git commit -am \"Fix search bug\""
  ],
  "cwd": "app",
  "solution": [
    "git log --oneline",
    "git tag v0.1 HEAD~2",
    "git tag -n"
  ],
  "hints": [
    {
      "tr": "`git tag <ad> <commit>`; commit `HEAD~2` ya da hash'i.",
      "en": "`git tag <name> <commit>`; the commit is `HEAD~2` or its hash."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit log --oneline\ngit tag v0.1 HEAD~2\ngit tag -n\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit log --oneline\ngit tag v0.1 HEAD~2\ngit tag -n\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "app",
      "tag_at": {
        "v0.1": "^Add prototype$"
      },
      "label": {
        "tr": "v0.1, Add prototype'ta",
        "en": "v0.1 is on Add prototype"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git tag -n\\b",
      "show": "git tag -n",
      "label": {
        "tr": "Mesajlarıyla listeledin",
        "en": "You listed with messages"
      }
    }
  ]
}
