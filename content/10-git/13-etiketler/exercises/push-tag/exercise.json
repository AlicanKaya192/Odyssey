{
  "id": "push-tag",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Etiketi gönder",
    "en": "Push the tag"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    {
      "remote": "https://github.com/ada/app.git",
      "files": {
        "app.txt": "v1\n"
      },
      "message": "Add prototype",
      "author": [
        "Ada Lovelace",
        "ada@example.com"
      ]
    },
    "git clone https://github.com/ada/app.git",
    "cd app",
    "echo \"search\" >> app.txt",
    "git commit -am \"Add search\"",
    "git push"
  ],
  "cwd": "app",
  "solution": [
    "git tag -a v1.0 -m \"Version 1.0\"",
    "git push origin v1.0"
  ],
  "hints": [
    {
      "tr": "`git push` etiket göndermez: `git push origin v1.0` ya da `git push --tags`.",
      "en": "`git push` doesn't push tags: `git push origin v1.0` or `git push --tags`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit tag -a v1.0 -m \"Version 1.0\"\ngit push origin v1.0\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit tag -a v1.0 -m \"Version 1.0\"\ngit push origin v1.0\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "app",
      "annotated": [
        "v1.0"
      ],
      "label": {
        "tr": "v1.0 açıklamalı",
        "en": "v1.0 is annotated"
      }
    },
    {
      "type": "git_state",
      "repo": "app",
      "remote_tags": {
        "url": "https://github.com/ada/app.git",
        "tags": [
          "v1.0"
        ]
      },
      "label": {
        "tr": "v1.0 GitHub'da",
        "en": "v1.0 is on GitHub"
      }
    }
  ]
}
