{
  "id": "choose-staged",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Hazırlık alanını seç",
    "en": "Choose what to stage"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Hello</h1>\" > index.html",
    "echo \"About\" > about.html",
    "git add .",
    "git commit -m \"Add pages\"",
    "echo \"<p>Welcome</p>\" >> index.html",
    "echo \"<p>Our team</p>\" >> about.html",
    "echo \"call the printer\" > draft.txt"
  ],
  "cwd": "site",
  "solution": [
    "git status -s",
    "git add index.html about.html",
    "git status -s"
  ],
  "hints": [
    {
      "tr": "`git add` birden çok dosya adı alabilir: `git add a b`.",
      "en": "`git add` can take several file names: `git add a b`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit status -s\ngit add index.html about.html\ngit status -s\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit status -s\ngit add index.html about.html\ngit status -s\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "staged": [
        "about.html",
        "index.html"
      ],
      "label": {
        "tr": "Hazırlık alanında index.html ve about.html",
        "en": "index.html and about.html are staged"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "untracked": [
        "draft.txt"
      ],
      "unstaged": [],
      "label": {
        "tr": "draft.txt izlenmiyor, başka hazırlanmamış değişiklik yok",
        "en": "draft.txt is untracked, no other unstaged change"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "commits": 1,
      "label": {
        "tr": "Yeni commit atılmadı",
        "en": "No new commit was made"
      }
    }
  ]
}
