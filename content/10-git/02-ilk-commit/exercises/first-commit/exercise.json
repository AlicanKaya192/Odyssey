{
  "id": "first-commit",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "İlk commit",
    "en": "The first commit"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "echo \"<h1>Hello</h1>\" > site/index.html"
  ],
  "cwd": "site",
  "solution": [
    "git init",
    "git status",
    "git add index.html",
    "git status",
    "git commit -m \"Add home page\""
  ],
  "hints": [
    {
      "tr": "Sıra: `git init`, `git add <dosya>`, `git commit -m \"<mesaj>\"`.",
      "en": "The order: `git init`, `git add <file>`, `git commit -m \"<message>\"`."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit init\ngit status\ngit add index.html\ngit status\ngit commit -m \"Add home page\"\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit init\ngit status\ngit add index.html\ngit status\ngit commit -m \"Add home page\"\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "label": {
        "tr": "site bir Git deposu",
        "en": "site is a Git repository"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "tracked": [
        "index.html"
      ],
      "label": {
        "tr": "index.html bir commit'te",
        "en": "index.html is in a commit"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "commits": 1,
      "last_message": "^Add home page$",
      "show_message": "Add home page",
      "label": {
        "tr": "Tek commit, mesajı Add home page",
        "en": "One commit, message Add home page"
      }
    }
  ]
}
