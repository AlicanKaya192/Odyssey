{
  "id": "commit-tracked",
  "kind": "terminal",
  "language": "git",
  "title": {
    "tr": "Tek komutla commit",
    "en": "Commit in one command"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "setup": [
    "mkdir site",
    "cd site",
    "git init",
    "echo \"<h1>Hello</h1>\" > index.html",
    "echo \"body {}\" > style.css",
    "git add .",
    "git commit -m \"Add home page\"",
    "echo \"<p>Hi</p>\" >> index.html",
    "echo \"p {}\" >> style.css",
    "echo \"Buy milk\" > todo.txt"
  ],
  "cwd": "site",
  "solution": [
    "git commit -am \"Update page\"",
    "git status -s"
  ],
  "hints": [
    {
      "tr": "`-a` izlenen dosyalardaki değişiklikleri kendisi hazırlar; `-m` ile birleşip `-am` olur. Yeni dosyalara dokunmaz.",
      "en": "`-a` stages the changes in tracked files itself; combined with `-m` it becomes `-am`. It leaves new files alone."
    },
    {
      "tr": "Çözümün tamamı (komutları sırayla yaz):\n\n```bash\ngit commit -am \"Update page\"\ngit status -s\n```",
      "en": "The full solution (type the commands in order):\n\n```bash\ngit commit -am \"Update page\"\ngit status -s\n```"
    }
  ],
  "checks": [
    {
      "type": "git_state",
      "repo": "site",
      "last_message": "^Update page$",
      "show_message": "Update page",
      "unstaged": [],
      "staged": [],
      "label": {
        "tr": "Update page commit'i iki değişikliği aldı",
        "en": "The Update page commit took both changes"
      }
    },
    {
      "type": "git_state",
      "repo": "site",
      "untracked": [
        "todo.txt"
      ],
      "not_tracked": [
        "todo.txt"
      ],
      "label": {
        "tr": "todo.txt izlenmeyen kaldı",
        "en": "todo.txt stayed untracked"
      }
    },
    {
      "type": "git_command",
      "pattern": "^git commit (-am|-a -m|-ma)\\b",
      "show": "git commit -am",
      "label": {
        "tr": "Tek komut: git commit -am",
        "en": "One command: git commit -am"
      }
    }
  ]
}
