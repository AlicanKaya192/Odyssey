  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.sql",
  "solution": "solution.sql",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`AS` sonuçtaki başlığı değiştiriyor: `sutun AS yeni_ad`.",
      "en": "`AS` changes the heading in the result: `column AS new_name`."
    },
    {
      "tr": "İki sütunun ikisine de ayrı ad veriyorsun; aralarında virgül var.",
      "en": "You are naming both columns; there is a comma between them."
    },
    {
      "tr": "Sorgunun tamamı:\n\n```sql\nSELECT ad AS urun, fiyat AS tutar FROM urunler;\n```",
      "en": "The whole query:\n\n```sql\nSELECT ad AS urun, fiyat AS tutar FROM urunler;\n```"
    }
  ],
  "checks": [
    {
      "type": "columns",
      "expected": [
        "urun",
        "tutar"
      ]
    },
