{
  "id": "sutuna-ad-vermek",
  "language": "tsql",
  "title": {
    "tr": "Sütuna ad vermek",
    "en": "Naming a column"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.sql",
  "solution": "solution.sql",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`AS` sonuçtaki başlığı değiştiriyor: `sutun AS yeni_ad`.",
      "en": "`AS` changes the heading in the result: `column AS new_name`."
    },
    {
      "tr": "İki sütunun ikisine de ayrı name veriyorsun; aralarında virgül var.",
      "en": "You are naming both columns; there is a comma between them."
    },
    {
      "tr": "Sorgunun tamamı:\n\n```sql\nSELECT name AS product, price AS amount FROM products;\n```",
      "en": "The whole query:\n\n```sql\nSELECT name AS product, price AS amount FROM products;\n```"
    }
  ],
  "checks": [
    {
      "type": "columns",
      "expected": [
        "product",
        "amount"
      ]
    },
    {
      "type": "rows",
      "ordered": false,
      "expected": [
        [
          "Keyboard",
          450.0
        ],
        [
          "Monitor",
          3200.0
        ],
        [
          "Mouse",
          220.0
        ],
        [
