{
  "id": "tek-kosul",
  "language": "tsql",
  "title": {
    "tr": "Tek koşulla süzmek",
    "en": "Filtering on one condition"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.sql",
  "solution": "solution.sql",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`WHERE` satırları süzüyor ve `SELECT ... FROM ...` ifadesinin sonuna yazılıyor.",
      "en": "`WHERE` sifts the rows and goes at the end of `SELECT ... FROM ...`."
    },
    {
      "tr": "Sayı karşılaştırmasında tırnak yok: `price > 1000`.",
      "en": "No quotes when comparing numbers: `price > 1000`."
    },
    {
      "tr": "Sorgunun tamamı:\n\n```sql\nSELECT name, price FROM products WHERE price > 1000;\n```",
      "en": "The whole query:\n\n```sql\nSELECT name, price FROM products WHERE price > 1000;\n```"
    }
  ],
  "checks": [
    {
      "type": "columns",
      "expected": [
        "name",
        "price"
      ]
    },
    {
      "type": "rows",
      "ordered": false,
      "expected": [
        [
          "Monitor",
          3200.0
        ],
        [
          "Laptop",
          24500.0
        ],
        [
          "Webcam",
          1150.0
        ],
        [
          "Desktop",
          18900.0
        ],
        [
          "Projector",
          7400.0
        ]
      ]
    }
  ]
}
