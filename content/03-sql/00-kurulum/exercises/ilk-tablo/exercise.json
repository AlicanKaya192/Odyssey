{
  "id": "ilk-tablo",
  "language": "tsql",
  "title": {
    "tr": "İlk tablon",
    "en": "Your first table"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.sql",
  "solution": "solution.sql",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "İki parça var: ne getirileceği (`SELECT`) ve nereden getirileceği (`FROM`).",
      "en": "There are two parts: what to bring back (`SELECT`) and where from (`FROM`)."
    },
    {
      "tr": "Bütün sütunlar için sütun adlarını tek tek yazmana gerek yok; `*` hepsini kapsıyor.",
      "en": "You do not have to list the column names one by one; `*` covers them all."
    },
    {
      "tr": "Sorgunun tamamı:\n\n```sql\nSELECT * FROM cities;\n```",
      "en": "The whole query:\n\n```sql\nSELECT * FROM cities;\n```"
    }
  ],
  "checks": [
    {
      "type": "columns",
      "expected": [
        "id",
        "name",
        "country",
        "population"
      ]
    },
    {
      "type": "rows",
      "ordered": false,
      "expected": [
        [
