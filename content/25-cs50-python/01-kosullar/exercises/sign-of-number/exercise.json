{
  "id": "sign-of-number",
  "title": {
    "tr": "Sayının İşareti",
    "en": "Sign of a Number"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "Üç dal: `if n > 0:`, `elif n < 0:`, `else:`.",
      "en": "Three branches: `if n > 0:`, `elif n < 0:`, `else:`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nn = int(input(\"n: \"))\nif n > 0:\n    print(\"positive\")\nelif n < 0:\n    print(\"negative\")\nelse:\n    print(\"zero\")\n```",
      "en": "The full solution:\n\n```python\nn = int(input(\"n: \"))\nif n > 0:\n    print(\"positive\")\nelif n < 0:\n    print(\"negative\")\nelse:\n    print(\"zero\")\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "5\n",
          "stdout": "positive"
        },
        {
          "stdin": "-3\n",
          "stdout": "negative"
        },
        {
          "stdin": "0\n",
          "stdout": "zero"
        }
      ]
    }
  ]
}
