  "hints": [
    {
      "tr": "`emoji.emojize(text, language=\"alias\")`.",
      "en": "`emoji.emojize(text, language=\"alias\")`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport emoji\n\ntext = input(\"Input: \")\nprint(\"Output:\", emoji.emojize(text, language=\"alias\"))\n```",
      "en": "The full solution:\n\n```python\nimport emoji\n\ntext = input(\"Input: \")\nprint(\"Output:\", emoji.emojize(text, language=\"alias\"))\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "unicode_output": true,
      "cases": [
        {
          "stdin": ":1st_place_medal:\n",
          "stdout": "Output: 🥇"
        },
        {
          "stdin": ":money_bag:\n",
          "stdout": "Output: 💰"
        },
        {
          "stdin": ":smile_cat:\n",
          "stdout": "Output: 😸"
        },
        {
          "stdin": "hello, :earth_africa:\n",
          "stdout": "Output: hello, 🌍"
        },
        {
          "stdin": "I :thumbsup: it\n",
          "stdout": "Output: I 👍 it"
        }
      ]
    }
  ]
}
