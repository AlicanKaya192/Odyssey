  "hints": [
    {
      "tr": "`for name in sys.argv[1:]:`.",
      "en": "`for name in sys.argv[1:]:`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport sys\n\nif len(sys.argv) < 2:\n    sys.exit(\"Too few arguments\")\n\nfor name in sys.argv[1:]:\n    print(f\"hello, {name}\")\n```",
      "en": "The full solution:\n\n```python\nimport sys\n\nif len(sys.argv) < 2:\n    sys.exit(\"Too few arguments\")\n\nfor name in sys.argv[1:]:\n    print(f\"hello, {name}\")\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "run": {
        "argv": [
          "David",
          "Carter",
          "Rongxin"
        ]
      },
      "cases": [
        {
          "argv": [
            "David",
            "Carter",
            "Rongxin"
          ],
          "stdout": "hello, David\nhello, Carter\nhello, Rongxin"
        },
        {
          "argv": [
            "Ada"
          ],
          "stdout": "hello, Ada"
        },
        {
          "argv": [],
          "exit": 1
        }
      ]
    }
  ]
