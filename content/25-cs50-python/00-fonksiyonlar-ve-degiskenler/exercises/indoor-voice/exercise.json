{
  "id": "indoor-voice",
  "title": {
    "tr": "Kapalı Alan Sesi",
    "en": "Indoor Voice"
  },
  "difficulty": 1,
  "group": "pset",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "Dizenin `lower` metodu bütün harfleri küçültür.",
      "en": "The `lower` method of a string lowercases every letter."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ntext = input(\"Text: \")\nprint(text.lower())\n```",
      "en": "The full solution:\n\n```python\ntext = input(\"Text: \")\nprint(text.lower())\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "HELLO\n",
          "stdout": "hello"
        },
        {
          "stdin": "THIS IS CS50\n",
          "stdout": "this is cs50"
        },
        {
          "stdin": "50\n",
          "stdout": "50"
        }
      ]
    }
  ]
}
