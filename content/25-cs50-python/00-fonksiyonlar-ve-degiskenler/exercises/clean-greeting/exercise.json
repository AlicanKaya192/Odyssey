{
  "id": "clean-greeting",
  "title": {
    "tr": "Düzgün Selam",
    "en": "A Tidy Greeting"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`strip` ve `title` art arda çağrılabilir: `name.strip().title()`.",
      "en": "`strip` and `title` can be chained: `name.strip().title()`."
    },
    {
      "tr": "f-string: `f\"hello, {name}\"`.",
      "en": "An f-string: `f\"hello, {name}\"`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nname = input(\"What's your name? \").strip().title()\nprint(f\"hello, {name}\")\n```",
      "en": "The full solution:\n\n```python\nname = input(\"What's your name? \").strip().title()\nprint(f\"hello, {name}\")\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "   david  \n",
          "stdout": "hello, David"
        },
        {
          "stdin": "carter zenke\n",
          "stdout": "hello, Carter Zenke"
        },
        {
          "stdin": "ALICE\n",
          "stdout": "hello, Alice"
        }
      ]
    }
  ]
}
