  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`replace(eski, yeni)` her `eski`'nin yerine `yeni` koyar.",
      "en": "`replace(old, new)` replaces every `old` with `new`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ntext = input(\"Text: \")\nprint(text.replace(\" \", \"...\"))\n```",
      "en": "The full solution:\n\n```python\ntext = input(\"Text: \")\nprint(text.replace(\" \", \"...\"))\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "This is CS50\n",
          "stdout": "This...is...CS50"
        },
        {
          "stdin": "This is our week on functions\n",
          "stdout": "This...is...our...week...on...functions"
        },
        {
          "stdin": "Let's implement a function called hello\n",
          "stdout": "Let's...implement...a...function...called...hello"
        }
      ]
    }
  ]
