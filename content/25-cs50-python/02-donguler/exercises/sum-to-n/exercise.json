    "tr": "1'den n'e Toplam",
    "en": "Sum From 1 to n"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
