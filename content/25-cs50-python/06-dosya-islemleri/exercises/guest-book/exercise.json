{
  "id": "guest-book",
  "title": {
    "tr": "Ziyaretçi Defteri",
    "en": "Guest Book"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`write` satır sonu eklemez: `file.write(f\"{name}\\n\")`.",
      "en": "`write` adds no line ending: `file.write(f\"{name}\\n\")`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nname = input(\"Name: \")\n\nwith open(\"guests.txt\", \"a\") as file:\n    file.write(f\"{name}\\n\")\n```",
      "en": "The full solution:\n\n```python\nname = input(\"Name: \")\n\nwith open(\"guests.txt\", \"a\") as file:\n    file.write(f\"{name}\\n\")\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "Bob\n",
          "files": {
            "guests.txt": "Ada\nAlan\n"
          },
          "expect_files": {
            "guests.txt": "Ada\nAlan\nBob"
          }
        },
        {
          "stdin": "Grace\n",
          "expect_files": {
            "guests.txt": "Grace"
          }
        },
        {
          "stdin": "Linus\n",
          "files": {
            "guests.txt": "Ada\n"
          },
          "expect_files": {
            "guests.txt": "Ada\nLinus"
          }
        }
      ]
    }
  ]
}
