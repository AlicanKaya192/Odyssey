{
  "id": "double-or-not",
  "title": {
    "tr": "İki Katı",
    "en": "Double It"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "`try` içinde yalnızca `int(input(...))` satırı dursun.",
      "en": "Keep only the `int(input(...))` line inside `try`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ntry:\n    n = int(input(\"Number: \"))\nexcept ValueError:\n    print(\"Not a number\")\nelse:\n    print(n * 2)\n```",
      "en": "The full solution:\n\n```python\ntry:\n    n = int(input(\"Number: \"))\nexcept ValueError:\n    print(\"Not a number\")\nelse:\n    print(n * 2)\n```"
    }
  ],
  "checks": [
    {
      "type": "stdio",
      "cases": [
        {
          "stdin": "21\n",
          "stdout": "42"
        },
        {
          "stdin": "cat\n",
          "stdout": "Not a number"
        },
        {
          "stdin": "4.5\n",
          "stdout": "Not a number"
        },
        {
          "stdin": "-8\n",
          "stdout": "-16"
        }
      ]
    },
    {
      "type": "ast_require",
      "node": "Try"
    }
  ]
}
