{
  "id": "rank-students",
  "title": {
    "tr": "Öğrencileri sırala",
    "en": "Rank the students"
  },
  "difficulty": 2,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
