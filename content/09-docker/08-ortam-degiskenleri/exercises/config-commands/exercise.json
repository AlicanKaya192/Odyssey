{
  "id": "config-commands",
  "title": {
    "tr": "Ayar komutları",
    "en": "Configuration commands"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "commands.sh",
  "files": [
    {
      "name": "commands.sh",
      "starter": "starter-commands.sh.{lang}",
      "solution": "solution-commands.sh"
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "`-e`, `--env-file`, `--build-arg`.",
      "en": "`-e`, `--env-file`, `--build-arg`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker run --rm -e APP_ENV=production app\ndocker run --rm --env-file app.env app\ndocker build --build-arg VERSION=2.1 -t app .\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker run --rm -e APP_ENV=production app\ndocker run --rm --env-file app.env app\ndocker build --build-arg VERSION=2.1 -t app .\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--rm": true,
        "--env": "APP_ENV=production"
      },
      "args": [
        "app"
      ],
      "show": "docker run --rm -e APP_ENV=production app"
    },
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--rm": true,
        "--env-file": "app.env"
      },
      "args": [
        "app"
      ],
      "show": "docker run --rm --env-file app.env app"
    },
    {
      "type": "command",
      "command": "build",
      "flags": {
        "--build-arg": "VERSION=2.1",
        "--tag": "app"
      },
      "args": [
        "."
      ],
      "show": "docker build --build-arg VERSION=2.1 -t app ."
    }
  ]
}
