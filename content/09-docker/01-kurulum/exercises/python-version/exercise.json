{
  "id": "python-version",
  "title": {
    "tr": "Konteynerdeki Python",
    "en": "The Python in the container"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Komut iki parça: `\"python\"` ve `\"--version\"`.",
      "en": "The command has two parts: `\"python\"` and `\"--version\"`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCMD [\"python\", \"--version\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCMD [\"python\", \"--version\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "exec_form",
      "instruction": "CMD",
      "args": [
        "python",
        "--version"
      ],
      "show": "CMD [\"python\", \"--version\"]"
    },
    {
      "type": "container",
      "expect": {
        "logs_contains": [
          "Python 3.13."
        ],
        "exit_code": 0
      }
    }
  ]
}
