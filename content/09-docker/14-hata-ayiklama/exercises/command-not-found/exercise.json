{
  "id": "command-not-found",
  "title": {
    "tr": "Komut bulunamadı",
    "en": "Command not found"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "`pyhton` → `python`.",
      "en": "`pyhton` → `python`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "exec_form",
      "instruction": "CMD",
      "args": [
        "python",
        "app.py"
      ],
      "show": "CMD [\"python\", \"app.py\"]"
    },
    {
      "type": "container",
      "expect": {
        "logs": "debugged and running",
        "exit_code": 0
      }
    }
  ]
}
