{
  "id": "spot-the-typo",
  "title": {
    "tr": "Yazım hatasını bul",
    "en": "Spot the typo"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "2. satırdaki talimatın doğru yazımı `WORKDIR`.",
      "en": "The instruction on line 2 is spelt `WORKDIR`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "has",
      "instruction": "WORKDIR",
      "show": "WORKDIR /app"
    },
    {
      "type": "container",
      "expect": {
        "logs": "debugged and running",
        "workdir": "/app"
      }
    }
  ]
}
