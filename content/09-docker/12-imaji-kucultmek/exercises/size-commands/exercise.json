{
  "id": "size-commands",
  "title": {
    "tr": "Boyut komutları",
    "en": "Size commands"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "commands.sh",
  "files": [
    {
      "name": "commands.sh",
      "starter": "starter-commands.sh.{lang}",
      "solution": "solution-commands.sh"
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "`--target build`, `docker history`, `docker run --rm report du -sh /report`.",
      "en": "`--target build`, `docker history`, `docker run --rm report du -sh /report`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker build --target build -t report:build .\ndocker history report\ndocker run --rm report du -sh /report\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker build --target build -t report:build .\ndocker history report\ndocker run --rm report du -sh /report\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "build",
      "flags": {
        "--target": "build",
        "--tag": "report:build"
      },
      "args": [
        "."
      ],
      "show": "docker build --target build -t report:build ."
    },
    {
      "type": "command",
      "command": "history",
      "args": [
        "report"
      ],
      "show": "docker history report"
    },
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--rm": true
      },
      "args": [
        "report",
        "du",
        "-sh",
        "/report"
      ],
      "show": "docker run --rm report du -sh /report"
    }
  ]
}
