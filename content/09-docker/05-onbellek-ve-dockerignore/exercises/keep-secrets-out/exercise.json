{
  "id": "keep-secrets-out",
  "title": {
    "tr": "Sırlar dışarıda",
    "en": "Secrets stay out"
  },
  "difficulty": 2,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": ".dockerignore",
  "files": [
    {
      "name": ".dockerignore",
      "starter": "starter-dockerignore.{lang}",
      "solution": "solution-dockerignore"
    },
    {
      "name": "Dockerfile",
      "readonly": true
    },
    {
      "name": "app.py",
      "readonly": true
    },
    {
      "name": ".env",
      "readonly": true
    },
    {
      "name": "notes.txt",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Her satıra bir ad: `.env`, `notes.txt`.",
      "en": "One name per line: `.env`, `notes.txt`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**.dockerignore**\n\n```text\n.env\nnotes.txt\n```",
      "en": "The full solution:\n\n**.dockerignore**\n\n```text\n.env\nnotes.txt\n```"
    }
  ],
  "checks": [
    {
      "type": "container",
      "expect": {
        "file_missing": [
          "/app/.env",
          "/app/notes.txt"
        ],
        "file_exists": [
          "/app/app.py"
        ],
        "logs": "files: ['.dockerignore', 'Dockerfile', 'app.py']"
      }
    }
  ]
}
