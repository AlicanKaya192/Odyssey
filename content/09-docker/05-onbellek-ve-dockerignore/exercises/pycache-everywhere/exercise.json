{
  "id": "pycache-everywhere",
  "title": {
    "tr": "Her klasörde",
    "en": "In every folder"
  },
  "difficulty": 2,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": ".dockerignore",
  "files": [
    {
      "name": ".dockerignore",
      "starter": "starter-dockerignore.{lang}",
      "solution": "solution-dockerignore"
    },
    {
      "name": "Dockerfile",
      "readonly": true
    },
    {
      "name": "main.py",
      "readonly": true
    },
    {
      "name": "shapes/__init__.py",
      "readonly": true
    },
    {
      "name": "shapes/square.py",
      "readonly": true
    },
    {
      "name": "shapes/__pycache__/square.cpython-313.pyc",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Her derinlik için `**/`.",
      "en": "`**/` for every depth."
    },
    {
      "tr": "Çözümün tamamı:\n\n**.dockerignore**\n\n```text\n**/__pycache__\n```",
      "en": "The full solution:\n\n**.dockerignore**\n\n```text\n**/__pycache__\n```"
    }
  ],
  "checks": [
    {
      "type": "container",
      "expect": {
        "file_missing": [
          "/app/shapes/__pycache__"
        ],
        "file_exists": [
          "/app/shapes/square.py"
        ],
        "logs": "area: 49"
      }
    }
  ]
}
