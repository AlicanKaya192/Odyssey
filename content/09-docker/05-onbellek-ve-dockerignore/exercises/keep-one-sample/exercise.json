{
  "id": "keep-one-sample",
  "title": {
    "tr": "Bir örnek kalsın",
    "en": "Keep one sample"
  },
  "difficulty": 3,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": ".dockerignore",
  "files": [
    {
      "name": ".dockerignore",
      "starter": "starter-dockerignore.{lang}",
      "solution": "solution-dockerignore"
    },
    {
      "name": "Dockerfile",
      "readonly": true
    },
    {
      "name": "report.py",
      "readonly": true
    },
    {
      "name": "data/sample.csv",
      "readonly": true
    },
    {
      "name": "data/full_export.csv",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "İkinci satır `!data/sample.csv`.",
      "en": "The second line is `!data/sample.csv`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**.dockerignore**\n\n```text\ndata/\n!data/sample.csv\n```",
      "en": "The full solution:\n\n**.dockerignore**\n\n```text\ndata/\n!data/sample.csv\n```"
    }
  ],
  "checks": [
    {
      "type": "container",
      "expect": {
        "file_missing": [
          "/app/data/full_export.csv"
        ],
        "file_exists": [
          "/app/data/sample.csv"
        ],
        "logs": "rows: 3\ndata files: ['sample.csv']"
      }
    }
  ]
}
