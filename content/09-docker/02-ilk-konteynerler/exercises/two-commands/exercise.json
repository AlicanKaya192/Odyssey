{
  "id": "two-commands",
  "title": {
    "tr": "İki komut, bir konteyner",
    "en": "Two commands, one container"
  },
  "difficulty": 2,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Üçüncü parça `\"echo start && echo done\"`.",
      "en": "The third part is `\"echo start && echo done\"`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM alpine:3.22\nCMD [\"sh\", \"-c\", \"echo start && echo done\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM alpine:3.22\nCMD [\"sh\", \"-c\", \"echo start && echo done\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "exec_form",
      "instruction": "CMD"
    },
    {
      "type": "container",
      "expect": {
        "logs": "start\ndone",
        "exit_code": 0
      }
    }
  ]
}
