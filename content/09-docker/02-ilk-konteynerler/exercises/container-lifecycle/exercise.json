    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker ps -a\ndocker exec sleeper ps\ndocker logs sleeper\ndocker stop sleeper\ndocker rm sleeper\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker ps -a\ndocker exec sleeper ps\ndocker logs sleeper\ndocker stop sleeper\ndocker rm sleeper\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "ps",
      "flags": {
        "--all": true
      },
      "show": "docker ps -a"
    },
    {
      "type": "command",
      "command": "exec",
      "args": [
        "sleeper",
        "ps"
      ],
      "show": "docker exec sleeper ps"
    },
    {
      "type": "command",
      "command": "logs",
      "args": [
        "sleeper"
      ],
      "show": "docker logs sleeper"
    },
    {
      "type": "command",
      "command": "stop",
      "args": [
        "sleeper"
      ],
      "show": "docker stop sleeper"
    },
    {
      "type": "command",
      "command": "rm",
      "args": [
        "sleeper"
      ],
      "show": "docker rm sleeper"
