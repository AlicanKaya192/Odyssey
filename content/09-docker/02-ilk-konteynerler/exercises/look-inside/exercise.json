{
  "id": "look-inside",
  "title": {
    "tr": "İçine gir",
    "en": "Go inside"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "commands.sh",
  "files": [
    {
      "name": "commands.sh",
      "starter": "starter-commands.sh.{lang}",
      "solution": "solution-commands.sh"
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "İçine girmek `-it`, kendiliğinden silmek `--rm`.",
      "en": "Going inside is `-it`, removing automatically `--rm`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker run -it --rm alpine:3.22 sh\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker run -it --rm alpine:3.22 sh\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--interactive": true,
        "--tty": true,
        "--rm": true
      },
      "args": [
        "alpine:3.22",
        "sh"
      ],
      "show": "docker run -it --rm alpine:3.22 sh"
    }
  ]
}
