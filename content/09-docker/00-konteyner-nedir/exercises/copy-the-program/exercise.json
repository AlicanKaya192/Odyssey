{
  "id": "copy-the-program",
  "title": {
    "tr": "Programı kopyala",
    "en": "Copy the program"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "Kopyalama talimatı `COPY kaynak hedef` biçiminde.",
      "en": "The copy instruction has the form `COPY source destination`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "order",
      "steps": [
        {
          "instruction": "FROM",
          "show": "FROM"
        },
        {
          "instruction": "COPY",
          "value": "^app\\.py \\.$",
          "show": "COPY app.py ."
        },
        {
          "instruction": "CMD",
          "show": "CMD"
        }
      ]
    }
  ]
}
