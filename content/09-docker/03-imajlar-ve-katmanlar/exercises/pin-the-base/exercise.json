{
  "id": "pin-the-base",
  "title": {
    "tr": "Sürümü sabitle",
    "en": "Pin the version"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Etiket `latest` değil `3.13-slim` olmalı.",
      "en": "The tag should be `3.13-slim`, not `latest`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "pinned"
    },
    {
      "type": "dockerfile",
      "rule": "has",
      "instruction": "FROM",
      "value": "^python:3\\.13-slim$",
      "show": "FROM python:3.13-slim"
    },
    {
      "type": "container",
      "expect": {
        "logs": "pinned and ready",
        "exit_code": 0
      }
    }
  ]
}
