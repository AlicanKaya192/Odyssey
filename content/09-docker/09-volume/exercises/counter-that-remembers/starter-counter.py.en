import os

# Write the counter to the /data folder so it stays when the container is removed.
path = "count.txt"
count = 0
if os.path.exists(path):
    with open(path) as handle:
        count = int(handle.read())
count += 1
with open(path, "w") as handle:
    handle.write(str(count))
print("count:", count)
