{
  "id": "volume-commands",
  "title": {
    "tr": "Volume komutları",
    "en": "Volume commands"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "commands.sh",
  "files": [
    {
      "name": "commands.sh",
      "starter": "starter-commands.sh.{lang}",
      "solution": "solution-commands.sh"
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "`docker volume create / ls / inspect / rm`; bağlamak `-v notes:/data`.",
      "en": "`docker volume create / ls / inspect / rm`; mounting is `-v notes:/data`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker volume create notes\ndocker run --rm -v notes:/data notesapp\ndocker volume ls\ndocker volume inspect notes\ndocker volume rm notes\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker volume create notes\ndocker run --rm -v notes:/data notesapp\ndocker volume ls\ndocker volume inspect notes\ndocker volume rm notes\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "volume create",
      "args": [
        "notes"
      ],
      "show": "docker volume create notes"
    },
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--rm": true,
        "--volume": "notes:/data"
      },
      "args": [
        "notesapp"
      ],
      "show": "docker run --rm -v notes:/data notesapp"
    },
    {
      "type": "command",
      "command": "volume ls",
      "show": "docker volume ls"
    },
    {
      "type": "command",
      "command": "volume inspect",
      "args": [
        "notes"
      ],
      "show": "docker volume inspect notes"
    },
    {
      "type": "command",
      "command": "volume rm",
      "args": [
        "notes"
      ],
      "show": "docker volume rm notes"
    }
  ]
}
