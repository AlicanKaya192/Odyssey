{
  "id": "build-commands",
  "title": {
    "tr": "Kurma komutları",
    "en": "Build commands"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "commands.sh",
  "files": [
    {
      "name": "commands.sh",
      "starter": "starter-commands.sh.{lang}",
      "solution": "solution-commands.sh"
    }
  ],
  "timeout_sec": 20,
  "hints": [
    {
      "tr": "Başka adlı Dockerfile `-f` ile gösteriliyor; bağlam yine `.`.",
      "en": "A differently named Dockerfile is given with `-f`; the context is still `.`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**commands.sh**\n\n```bash\ndocker build -t greeter .\ndocker run --rm greeter\ndocker build -f Dockerfile.dev -t greeter:dev .\n```",
      "en": "The full solution:\n\n**commands.sh**\n\n```bash\ndocker build -t greeter .\ndocker run --rm greeter\ndocker build -f Dockerfile.dev -t greeter:dev .\n```"
    }
  ],
  "checks": [
    {
      "type": "command",
      "command": "build",
      "flags": {
        "--tag": "greeter"
      },
      "args": [
        "."
      ],
      "forbid_flags": [
        "--file"
      ],
      "show": "docker build -t greeter ."
    },
    {
      "type": "command",
      "command": "run",
      "flags": {
        "--rm": true
      },
      "args": [
        "greeter"
      ],
      "show": "docker run --rm greeter"
    },
    {
      "type": "command",
      "command": "build",
      "flags": {
        "--file": "Dockerfile.dev",
        "--tag": "greeter:dev"
      },
      "args": [
        "."
      ],
      "show": "docker build -f Dockerfile.dev -t greeter:dev ."
    }
  ]
}
