{
  "id": "keep-the-folder",
  "title": {
    "tr": "Klasörü koru",
    "en": "Keep the folder"
  },
  "difficulty": 2,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "main.py",
      "readonly": true
    },
    {
      "name": "textkit/__init__.py",
      "readonly": true
    },
    {
      "name": "textkit/shout.py",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Hedefe de klasörün adını yaz: `./textkit/`.",
      "en": "Write the folder's name in the destination too: `./textkit/`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY main.py .\nCOPY textkit/ ./textkit/\nCMD [\"python\", \"main.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY main.py .\nCOPY textkit/ ./textkit/\nCMD [\"python\", \"main.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "container",
      "expect": {
        "logs": "FOLDERS MATTER!",
        "file_exists": [
          "/app/textkit/shout.py"
        ]
      }
    }
  ]
}
