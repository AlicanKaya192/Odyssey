{
  "id": "own-folder",
  "title": {
    "tr": "Kendi klasörü",
    "en": "Its own folder"
  },
  "difficulty": 1,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "`WORKDIR /srv`.",
      "en": "`WORKDIR /srv`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /srv\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /srv\nCOPY app.py .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "order",
      "steps": [
        {
          "instruction": "WORKDIR",
          "value": "^/srv/?$",
          "show": "WORKDIR /srv"
        },
        {
          "instruction": "COPY",
          "show": "COPY app.py ."
        }
      ]
    },
    {
      "type": "container",
      "expect": {
        "logs": "working in /srv",
        "workdir": "/srv",
        "file_exists": [
          "/srv/app.py"
        ],
        "file_missing": [
          "/app.py"
        ]
      }
    }
  ]
}
