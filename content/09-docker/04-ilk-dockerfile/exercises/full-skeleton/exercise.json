{
  "id": "full-skeleton",
  "title": {
    "tr": "İskeletin tamamı",
    "en": "The whole skeleton"
  },
  "difficulty": 2,
  "language": "docker",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "Dockerfile",
  "files": [
    {
      "name": "Dockerfile",
      "starter": "starter-Dockerfile.{lang}",
      "solution": "solution-Dockerfile"
    },
    {
      "name": "app.py",
      "readonly": true
    },
    {
      "name": "requirements.txt",
      "readonly": true
    }
  ],
  "timeout_sec": 180,
  "hints": [
    {
      "tr": "Talimatlar sırayla: FROM, WORKDIR, COPY, RUN, COPY, CMD.",
      "en": "The instructions in order: FROM, WORKDIR, COPY, RUN, COPY, CMD."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\nCOPY . .\nCMD [\"python\", \"app.py\"]\n```",
      "en": "The full solution:\n\n**Dockerfile**\n\n```dockerfile\nFROM python:3.13-slim\nWORKDIR /app\nCOPY requirements.txt .\nRUN pip install --no-cache-dir -r requirements.txt\nCOPY . .\nCMD [\"python\", \"app.py\"]\n```"
    }
  ],
  "checks": [
    {
      "type": "dockerfile",
      "rule": "order",
      "steps": [
        {
          "instruction": "FROM",
          "value": "^python:3\\.13-slim$",
          "show": "FROM python:3.13-slim"
        },
        {
          "instruction": "WORKDIR",
          "value": "^/app/?$",
          "show": "WORKDIR /app"
        },
        {
          "instruction": "COPY",
          "value": "^requirements\\.txt ",
          "show": "COPY requirements.txt ."
        },
        {
          "instruction": "RUN",
          "value": "pip install .*-r requirements\\.txt",
          "show": "RUN pip install ... -r requirements.txt"
        },
        {
          "instruction": "COPY",
          "value": "^\\. ",
          "show": "COPY . ."
        },
        {
          "instruction": "CMD",
          "show": "CMD"
        }
      ]
    },
    {
      "type": "container",
      "expect": {
        "logs": "Hello from the greeter",
        "workdir": "/app",
        "file_exists": [
          "/app/app.py",
          "/app/requirements.txt"
        ]
      }
    }
  ]
}
