{
  "id": "default-feature",
  "title": {
    "tr": "Varsayılan Feature",
    "en": "A Default Feature"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "src/main.rs",
  "files": [
    {
      "name": "Cargo.toml",
      "starter": "starter-Cargo.{lang}.toml",
      "solution": "solution-Cargo.toml"
    },
    {
      "name": "src/main.rs",
      "readonly": true
    }
  ],
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`[features]` altına `default = [\"shout\"]`.",
      "en": "Under `[features]`, `default = [\"shout\"]`."
    },
    {
      "tr": "Çözümün tamamı:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"shop\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = [\"shout\"]\nshout = []\n```",
      "en": "The full solution:\n\n**Cargo.toml**\n\n```toml\n[package]\nname = \"shop\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\ndefault = [\"shout\"]\nshout = []\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "HELLO"
    }
  ]
}
