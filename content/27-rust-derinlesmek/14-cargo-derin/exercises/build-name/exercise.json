{
  "id": "build-name",
  "title": {
    "tr": "Derleme Betiği",
    "en": "A Build Script"
  },
  "difficulty": 3,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "entry": "src/main.rs",
  "files": [
    {
      "name": "build.rs",
      "starter": "starter-build.{lang}.rs",
      "solution": "solution-build.rs"
