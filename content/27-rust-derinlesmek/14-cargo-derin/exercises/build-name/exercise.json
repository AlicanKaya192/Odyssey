    {
      "name": "Cargo.toml",
      "readonly": true
    },
    {
      "name": "src/main.rs",
      "readonly": true
    }
  ],
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`println!(\"cargo:rustc-env=RELEASE_NAME=spring\");`",
      "en": "`println!(\"cargo:rustc-env=RELEASE_NAME=spring\");`"
    },
    {
      "tr": "Çözümün tamamı:\n\n**build.rs**\n\n```rust\nfn main() {\n    println!(\"cargo:rerun-if-changed=build.rs\");\n    println!(\"cargo:rustc-env=RELEASE_NAME=spring\");\n}\n```",
      "en": "The full solution:\n\n**build.rs**\n\n```rust\nfn main() {\n    println!(\"cargo:rerun-if-changed=build.rs\");\n    println!(\"cargo:rustc-env=RELEASE_NAME=spring\");\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "release spring"
    }
  ]
}
