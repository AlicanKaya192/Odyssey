  "hints": [
    {
      "tr": "`values.iter().filter(|x| **x % 2 == 0).map(|x| x * x).collect()`",
      "en": "`values.iter().filter(|x| **x % 2 == 0).map(|x| x * x).collect()`"
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn even_squares(values: &[i32]) -> Vec<i32> {\n    values.iter().filter(|x| **x % 2 == 0).map(|x| x * x).collect()\n}\n\nfn main() {\n    println!(\"{:?}\", even_squares(&[1, 2, 3, 4]));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn even_squares(values: &[i32]) -> Vec<i32> {\n    values.iter().filter(|x| **x % 2 == 0).map(|x| x * x).collect()\n}\n\nfn main() {\n    println!(\"{:?}\", even_squares(&[1, 2, 3, 4]));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(even_squares(&[1, 2, 3, 4]), vec![4, 16]);",
          "label": {
            "tr": "karışık",
            "en": "mixed"
          }
        },
        {
          "code": "assert_eq!(even_squares(&[1]), Vec::<i32>::new());",
          "label": {
            "tr": "çift yok",
            "en": "no evens"
          }
        },
        {
          "code": "assert_eq!(even_squares(&[]), Vec::<i32>::new());",
          "label": {
            "tr": "boş",
            "en": "empty"
          }
        }
      ]
    },
    {
      "type": "rust_forbid",
