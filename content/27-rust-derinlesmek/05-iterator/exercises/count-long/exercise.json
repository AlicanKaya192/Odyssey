{
  "id": "count-long",
  "title": {
    "tr": "Uzun Kelimeler",
    "en": "Long Words"
  },
  "difficulty": 1,
  "language": "rust",
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.rs",
  "solution": "solution.rs",
  "timeout_sec": 45,
  "hints": [
    {
      "tr": "`split_whitespace`, `filter`, `count`.",
      "en": "`split_whitespace`, `filter`, `count`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```rust\nfn long_words(text: &str, min: usize) -> usize {\n    text.split_whitespace().filter(|w| w.len() >= min).count()\n}\n\nfn main() {\n    println!(\"{}\", long_words(\"a bcd ef\", 2));\n}\n```",
      "en": "The full solution:\n\n```rust\nfn long_words(text: &str, min: usize) -> usize {\n    text.split_whitespace().filter(|w| w.len() >= min).count()\n}\n\nfn main() {\n    println!(\"{}\", long_words(\"a bcd ef\", 2));\n}\n```"
    }
  ],
  "checks": [
    {
      "type": "rust_test",
      "tests": [
        {
          "code": "assert_eq!(long_words(\"a bcd ef\", 2), 2);",
          "label": {
            "tr": "iki",
            "en": "two"
          }
        },
        {
          "code": "assert_eq!(long_words(\"\", 1), 0);",
          "label": {
            "tr": "boş",
            "en": "empty"
          }
        },
        {
          "code": "assert_eq!(long_words(\"abc\", 3), 1);",
          "label": {
            "tr": "tam sınır",
            "en": "exact boundary"
          }
        }
      ]
    },
    {
      "type": "rust_forbid",
      "pattern": "\\bfor\\b",
      "show": "for"
    }
  ]
}
