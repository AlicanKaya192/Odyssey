  "hints": [
    {
      "tr": "İkisini de `torch.tensor` yap.",
      "en": "Make both `torch.tensor`s."
    },
    {
      "tr": "`torch.allclose(a, b, atol=atol)`.",
      "en": "`torch.allclose(a, b, atol=atol)`."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\nimport torch\n\n\ndef golden_ok(expected, actual, atol):\n    return torch.allclose(torch.tensor(actual), torch.tensor(expected), atol=atol)\n\nprint(golden_ok([[1.0, 2.0]], [[1.0, 2.000001]], 1e-5))\nprint(golden_ok([[1.0, 2.0]], [[1.0, 2.1]], 1e-5))\n```",
      "en": "The full solution:\n\n```python\nimport torch\n\n\ndef golden_ok(expected, actual, atol):\n    return torch.allclose(torch.tensor(actual), torch.tensor(expected), atol=atol)\n\nprint(golden_ok([[1.0, 2.0]], [[1.0, 2.000001]], 1e-5))\nprint(golden_ok([[1.0, 2.0]], [[1.0, 2.1]], 1e-5))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "golden_ok",
      "cases": [
        {
          "args": [
            [
              1.0
            ],
            [
              1.0
            ],
            0.0
          ],
          "returns": true
        },
        {
          "args": [
            [
              1.0
            ],
            [
              1.5
            ],
            0.1
          ],
          "returns": false
        },
        {
          "args": [
