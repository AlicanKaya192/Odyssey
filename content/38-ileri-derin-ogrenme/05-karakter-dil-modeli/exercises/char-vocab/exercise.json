{
  "id": "char-vocab",
  "title": {
    "tr": "Karakter sözlüğü",
    "en": "A character vocabulary"
  },
  "difficulty": 1,
  "prompt": {
    "tr": "prompt.tr.md",
    "en": "prompt.en.md"
  },
  "starter": "starter.{lang}.py",
  "solution": "solution.py",
  "timeout_sec": 30,
  "hints": [
    {
      "tr": "Farklı karakterler için `set(text)`.",
      "en": "`set(text)` for distinct characters."
    },
    {
      "tr": "`sorted(...)` liste döndürür.",
      "en": "`sorted(...)` returns a list."
    },
    {
      "tr": "Çözümün tamamı:\n\n```python\ndef char_vocab(text):\n    return sorted(set(text))\n\nprint(char_vocab(\"hello world\"))\n```",
      "en": "The full solution:\n\n```python\ndef char_vocab(text):\n    return sorted(set(text))\n\nprint(char_vocab(\"hello world\"))\n```"
    }
  ],
  "checks": [
    {
      "type": "function",
      "name": "char_vocab",
      "cases": [
        {
          "args": [
            "aba"
          ],
          "returns": [
            "a",
            "b"
          ]
        },
        {
          "args": [
            "z y"
          ],
          "returns": [
            " ",
            "y",
            "z"
          ]
        },
        {
          "args": [
            ""
          ],
          "returns": []
        }
      ]
    },
    {
      "type": "stdout",
      "match": "trimmed_lines",
      "expected": "[' ', 'd', 'e', 'h', 'l', 'o', 'r', 'w']"
    }
  ]
}
