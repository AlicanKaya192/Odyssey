# Ders materyalleri büyük dosyalar, LFS ile tutuluyor.
#
# LFS yalnızca `content/` altını kapsıyor. Uygulamanın kendi kaynakları
# (simge gibi) LFS'e girmemeli: git-lfs kurulu olmadan klonlayan biri o
# dosyaları metin işaretçisi olarak alır ve uygulama bozuk açılır.
content/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
content/**/*.png  filter=lfs diff=lfs merge=lfs -text
content/**/*.jpg  filter=lfs diff=lfs merge=lfs -text

# Metin dosyalarında satır sonu tutarlılığı
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.qss  text eol=lf
*.txt  text eol=lf

# İkili dosyalar bozulmasın
*.ico  binary
*.png  binary
*.pdf  binary
