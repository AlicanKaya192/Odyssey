# Ders materyalleri büyük dosyalar, LFS ile tutuluyor.
#
# LFS yalnızca `content/` altını kapsıyor. Uygulamanın kendi kaynakları
# (simge gibi) LFS'e girmemeli: git-lfs kurulu olmadan klonlayan biri o
# dosyaları metin işaretçisi olarak alır ve uygulama bozuk açılır.
content/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
content/**/*.png  filter=lfs diff=lfs merge=lfs -text
content/**/*.jpg  filter=lfs diff=lfs merge=lfs -text

# CS50'nin resimlerini alıştırmanın kendisi açıyor (Pillow, fpdf2): yayın
# derlemesi LFS'siz çektiği için işaretçi olarak gelirlerse alıştırma bozulur.
# Küçükler (toplam ~75 KB), düz tutuluyor.
content/25-cs50-python/**/*.png  -filter -diff -merge binary
content/25-cs50-python/**/*.jpg  -filter -diff -merge binary

# Metin dosyalarında satır sonu tutarlılığı
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.qss  text eol=lf
*.txt  text eol=lf

# İkili dosyalar bozulmasın
*.ico  binary
*.png  binary
*.pdf  binary

# Cargo her dosyanın özetini denetliyor (.cargo-checksum.json): satır sonu
# değişirse paketler derlenmez.
rust-vendor/** -text -diff linguist-vendored
