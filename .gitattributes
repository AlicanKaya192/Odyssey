# Ders notları ve görseller büyük dosyalar, LFS ile tutuluyor
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text

# Metin dosyalarında satır sonu tutarlılığı
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.qss  text eol=lf
*.txt  text eol=lf
