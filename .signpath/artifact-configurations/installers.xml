<?xml version="1.0" encoding="utf-8"?>
<!--
  Signs the installers built from the already signed application files:
  the full installer (Odyssey-X.Y.Z-setup.exe) and the patch installers
  (Odyssey-X.Y.Z-patch-A.B.C.exe).

  This file mirrors the artifact configuration "installers" of the SignPath
  project "odyssey".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Odyssey-*-setup.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file-set>
      <include path="Odyssey-*-patch-*.exe" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
