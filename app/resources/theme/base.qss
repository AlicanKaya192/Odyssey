/* Uygulamanın tek stil dosyası.
 *
 * Buradaki yer tutucular (at işaretiyle sarılmış isimler) app/core/theme.py
 * tarafından, seçili temanın belirteçleriyle doldurulur. Widget'ların içine
 * dağınık stil yazılmaz.
 *
 * Qt'nin stil dosyaları gölge desteklemiyor; gölgeler
 * app/widgets/effects.py içindeki yardımcıyla veriliyor.
 */

/* --- Genel ---------------------------------------------------------------- */

QWidget {
    background-color: @bg@;
    color: @text@;
    font-family: @font_ui@;
    font-size: @font_md@px;
}

QMainWindow, QDialog { background-color: @bg@; }

/* Çerçevesiz kip pencereler (ayarlar, profil düzenleme).
 *
 * Windows'un başlık çubuğu ve kenarlığı kaldırıldığı için pencerenin
 * nerede bittiğini bir şeyin söylemesi gerekiyor; koyu temada pencere
 * ile arkasındaki sayfa neredeyse aynı tondaydı. */
QDialog[role="modal"] {
    background-color: @surface@;
    border: 1px solid @border_strong@;
    border-radius: 22px;
}
QWidget:disabled { color: @text_muted@; }

/* Etiketler kendi zeminini taşımamalı; farklı renkteki bir yüzeyin üzerinde
 * arkalarında uyumsuz dikdörtgen görünüyor. */
QLabel { background-color: transparent; }

/* Kartın içine konan düz taşıyıcılar.
 *
 * Yukarıdaki genel `QWidget` kuralı **sayfa zeminini** boyuyor; bir kartın
 * içindeki çıplak `QWidget` bu yüzden kartta koyu bir delik açıyor
 * (profilde yıl seçicisinin arkasında görüldü: kart #171A21 iken oradaki
 * alan #0F1116 çıkıyordu). Yalnızca yerleşim için kullanılan taşıyıcılara
 * bu rol veriliyor. */
QWidget[role="bare"] { background-color: transparent; }

/* Kullanıcının ürettiği görselin kutusu. Zemin `surface_alt`: grafiklerin
 * çoğunun kendi zemini beyaz ve kart rengiyle karışıyordu. */
QFrame[role="artifact"] {
    background-color: @surface_alt@;
    border: 1px solid @border@;
    border-radius: @radius_sm@px;
}

/* Rozetler. Kilitli olan soluk ama **görünür**: neyin kazanılabileceğini
 * göstermek, yalnızca kazanılanları göstermekten daha çok işe yarıyor. */
QFrame[role="badge"] {
    background-color: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 24px;
}

QFrame[role="badge"][earned="true"] {
    background-color: @accent@;
    border: 1px solid @accent@;
}

/* Prototip `.bdg`: kazanılan ad kalın ve beyaz, kilitli olan soluk. */
QLabel[role="badge-name"] {
    color: @text_faint@;
    font-size: 12.5px;
    font-weight: 600;
}

QLabel[role="badge-name"][earned="true"] { color: @text@; font-weight: 700; }

QFrame[role="progress-track"] {
    background-color: @border@;
    border: none;
    border-radius: 4px;
}

QFrame[role="progress-fill"] {
    background-color: @accent@;
    border: none;
    border-radius: 4px;
}

QFrame[role="divider"] {
    background-color: @border@;
    border: none;
    max-height: 1px;
}

QScrollArea, QScrollArea > QWidget > QWidget { background-color: transparent; }

/* --- Yüzeyler ------------------------------------------------------------- */

QFrame[surface="card"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
}

QFrame[surface="plain"] {
    background-color: @surface@;
    border: none;
}

QFrame[surface="alt"] {
    background-color: @surface_alt@;
    border: none;
}

QFrame[role="separator"] {
    background-color: @border@;
    max-height: 1px;
    border: none;
}

/* --- Sol ikon şeridi ------------------------------------------------------ */

/* Her ekranın altındaki telif şeridi. Sayfanın parçası gibi durması için
 * kendi zemini yok; yalnızca ince bir çizgiyle içerikten ayrılıyor. */
/* Üstteki ince çizgiyi `Footer.paintEvent` çiziyor (tek ekran pikseli). */
QFrame[role="footer"] {
    background-color: transparent;
    border: none;
}

QLabel[role="footnote"] {
    color: @text_muted@;
    font-size: @font_xs@px;
}

/* Şeridin kendisi sayfa zemininde; menü paneli (yuvarlak, gölgeli) Rail
   tarafından çiziliyor. Sağdaki uzun çizgi kalktı. */
QFrame[role="rail"] {
    background-color: @bg@;
    border: none;
}

QPushButton[variant="rail"] {
    background-color: transparent;
    border: none;
    border-radius: @radius_lg@px;
    padding: 0;
    min-width: 52px;
    max-width: 52px;
    min-height: 50px;
    max-height: 50px;
    font-size: @font_xl@px;
    color: @text_muted@;
}

QPushButton[variant="rail"]:hover { background-color: @surface_hover@; }

/* Seçili düğmenin zemini `RailIndicator`'da çiziliyor (kayan gösterge). */
QPushButton[variant="rail"][active="true"] {
    background-color: transparent;
    color: @accent@;
}


/* --- Üst şerit ------------------------------------------------------------ */

/* Şerit sayfayla aynı zeminde duruyor. Ayrı bir yüzey rengi verildiğinde
   üstte kopuk bir blok gibi görünüyordu; alttaki ince çizgi ayrımı zaten
   yeterince yapıyor. */
/* Bölüm sekmelerinin şeridi: başlığın altında, sekmeler ortada (F1). */
/* Alttaki ince çizgiler kodda (`paint_hairline`): QSS kenarlığı %125
   ölçekte iki piksele yayılıp kalın görünüyordu. */
QFrame[role="subbar"] {
    background-color: transparent;
    border: none;
}

QFrame[role="topbar"] {
    background-color: transparent;
    border: none;
}

/* --- Segmented control ---------------------------------------------------- */

/* Kutu yok. Şerit sayfayla aynı zemine geçince dolu gri kutu üstte
   yamalı duruyordu; seçili sekmeyi alttaki çizgi belli ediyor. */
QFrame[role="segment-group"] {
    background-color: transparent;
    border: none;
}

/* Sekme: kutu, kayan hap ve vurgu çizgisi SegmentedControl.paintEvent'te. */
QPushButton[variant="segment"] {
    background-color: transparent;
    border: none;
    border-radius: 9px;
    padding: 7px 13px;
    min-height: 0px;
    font-size: @font_sm@px;
    font-weight: 600;
    color: @text_muted@;
}

QPushButton[variant="segment"]:hover { color: @text@; }

/* Prototip `.seg`: sayfa zemininde kutu, seçili seçenek nötr bir hap. */
QFrame[role="segmented"] {
    background-color: @bg@;
    border: 1px solid @border@;
    border-radius: 11px;
}

/* Tek seçenekli seçicide zemin bir şey anlatmıyor: seçilmemiş alan yok. */
QFrame[role="segmented"][single="true"] {
    background-color: transparent;
    border-color: transparent;
}

QPushButton[variant="pill"] {
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 0px;
    font-size: 12.5px;
    font-weight: 600;
    color: @text_muted@;
}

QPushButton[variant="pill"]:hover { color: @text@; }

QPushButton[variant="pill"][active="true"] {
    background-color: @surface_alt@;
    color: @text@;
}

/* Sayfa okları: yuvarlak, hafif zeminli.
 *
 * Önce çıplak bir simgeydi; kartın kenarında tek başına duran bir ok
 * tıklanabilir görünmüyordu. Daire ve zemin ona bir düğme kimliği
 * veriyor, sınırda olduğunda ise sönüyor. */
QPushButton[variant="page-nav"] {
    background-color: @surface_alt@;
    border: 1px solid @border@;
    border-radius: 17px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;
}

QPushButton[variant="page-nav"]:hover {
    background-color: @accent_soft@;
    border-color: @accent@;
}

QPushButton[variant="page-nav"]:pressed { background-color: @surface_hover@; }

QPushButton[variant="page-nav"]:disabled {
    background-color: transparent;
    border-color: @border@;
}

QPushButton[variant="segment"][active="true"] {
    color: @text@;
    background-color: transparent;
}

/* --- Başlıklar ve metin --------------------------------------------------- */

QLabel[role="display"] {
    font-size: @font_display@px;
    font-weight: 700;
    color: @text@;
}

QLabel[role="title"] {
    font-family: @font_display@;
    font-size: @font_xxl@px;
    font-weight: 700;
    color: @text@;
}

QLabel[role="subtitle"] {
    font-family: @font_display@;
    font-size: @font_lg@px;
    font-weight: 650;
    color: @text@;
}

QLabel[role="heading"] {
    font-size: @font_md@px;
    font-weight: 650;
    color: @text@;
}

QLabel[role="muted"] {
    color: @text_muted@;
    font-size: @font_sm@px;
}

/* Başlık şeridindeki bağlam satırı: küçük, aralıklı, vurgu renginde.
   Rengi Python'dan veriliyor çünkü ekrana göre değişiyor. */
QLabel[role="eyebrow"] {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 1.4px;
}

/* Ekran adı. Boyutu ve ağırlığı Python'dan veriliyor; burada yalnızca
   renk ve harf aralığı ayarlanıyor. */
QLabel[role="screen"] {
    font-family: @font_display@;
    font-size: 28px;
    font-weight: 700;
    color: @text@;
    letter-spacing: -.3px;
}

QLabel[role="section"] {
    color: @text_muted@;
    /* Sabit piksel yazılmaz: ölçek `tokens.py` içinde tek yerden
       yönetiliyor. Bu rol uygulamanın her yerinde kullanılıyor. */
    font-size: @font_sm@px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel[role="chip"] {
    background-color: @surface_alt@;
    color: @text_muted@;
    border-radius: @radius_pill@px;
    padding: 5px 12px;
    font-size: @font_xs@px;
    font-weight: 650;
}

QLabel[role="chip"][tone="success"] {
    background-color: @success_soft@;
    color: @success@;
}

QLabel[role="chip"][tone="warning"] {
    background-color: @warning_soft@;
    color: @warning@;
}

QLabel[role="chip"][tone="accent"] {
    background-color: @accent_soft@;
    color: @accent@;
}

QLabel[tone="success"] { color: @success@; }
QLabel[tone="danger"]  { color: @danger@; }
QLabel[tone="warning"] { color: @warning@; }
QLabel[tone="accent"]  { color: @accent@; }
QLabel[tone="inverse"] { color: #FFFFFF; }

/* --- Düğmeler ------------------------------------------------------------- */

QPushButton {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_md@px;
    padding: 11px 21px;
    font-size: @font_sm@px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover  { background-color: @surface_hover@; }
QPushButton:pressed { background-color: @surface_alt@; }

QPushButton:disabled {
    color: @text_muted@;
    border-color: @border@;
    background-color: @surface_alt@;
}

/* Birincil düğme: vurgudan ikinci vurguya degrade (ui-taslak.md B1). */
QPushButton[variant="primary"] {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accent@, stop:1 @accent_second@);
    color: #FFFFFF;
    border: 1px solid @accent_second@;
}

QPushButton[variant="primary"]:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @accent_hover@, stop:1 @accent@);
    border-color: @accent@;
}

QPushButton[variant="primary"]:pressed {
    background-color: @accent_second@;
    border-color: @accent_second@;
}

QPushButton[variant="primary"]:disabled {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 @primary_dim@, stop:1 @primary_dim_2@);
    border-color: @primary_dim_2@;
    color: @primary_dim_text@;
}

/* Geri dönüşü olmayan eylemin düğmesi. Vurgu renginden ayrı bir renk
 * kullanılıyor: "birincil" ile "tehlikeli" aynı görünürse insan ikisini
 * ayırt etmeden basıyor. */
QPushButton[variant="danger"] {
    background-color: @danger@;
    color: #FFFFFF;
    border: 1px solid @danger@;
}

QPushButton[variant="danger"]:hover {
    background-color: @danger_hover@;
    border-color: @danger_hover@;
}

QLabel[role="dialog-title"] {
    font-size: @font_lg@px;
    font-weight: 700;
    color: @text@;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: @text_muted@;
    padding: 8px 14px;
}

QPushButton[variant="ghost"]:hover {
    background-color: @surface_hover@;
    color: @text@;
}

/* Açık/kapalı durumu olan hayalet düğme (bölümdeki "Not al"): açıkken
 * zemini var, panelin açık olduğu düğmeye bakınca da anlaşılıyor. */
QPushButton[variant="ghost"][active="true"] {
    background-color: @surface_hover@;
    color: @text@;
}

QPushButton[variant="small"] {
    padding: 7px 14px;
    font-size: @font_xs@px;
}

/* Alıştırma numaraları. Sürüm notlarındaki sayfa düğmeleriyle aynı dili
   konuşuyorlar: seçili olan vurgu renginde dolu, diğerleri çerçeveli. */
QPushButton[variant="number"] {
    min-width: 30px;
    padding: 5px 9px;
    font-size: @font_xs@px;
    font-weight: 700;
    border-radius: @radius_sm@px;
}

QPushButton[variant="number"][active="true"] {
    background-color: @accent@;
    border-color: @accent@;
    color: #FFFFFF;
}

QPushButton[variant="number"][active="true"]:hover {
    background-color: @accent_hover@;
    border-color: @accent_hover@;
}

QPushButton:focus { outline: none; border-color: @accent@; }

/* Sayfa içi başlık listesi (sağ sütun) */
QPushButton[variant="toc"] {
    background-color: transparent;
    border: none;
    border-left: 2px solid @border@;
    border-radius: 0;
    padding: 7px 0 7px 14px;
    text-align: left;
    font-size: @font_sm@px;
    font-weight: 500;
    color: @text_muted@;
}

QPushButton[variant="toc"]:hover { color: @text@; }

QPushButton[variant="toc"][active="true"] {
    color: @accent@;
    border-left-color: @accent@;
    font-weight: 650;
}

/* Ders notu listesi (sol sütun) */
QPushButton[variant="listitem"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius_md@px;
    padding: 12px 14px;
    text-align: left;
    font-size: @font_sm@px;
    font-weight: 500;
    color: @text@;
}

QPushButton[variant="listitem"]:hover { background-color: @surface_hover@; }

QPushButton[variant="listitem"][active="true"] {
    background-color: @surface@;
    border-color: @border@;
    font-weight: 650;
}

/* --- Öğrenme yolu düğümleri ----------------------------------------------- */

/* Boy kenarlığı saymıyor: 74 + 2 x 3 = 80 piksellik bir halka. Tam daire
 * için yarıçap bütün boyun yarısı (40); 37 verildiğinde halka köşeli bir
 * kare gibi duruyordu. 2 piksel kenarlıklı hâllerde boy 78, yarıçap 39. */
/* Profilde yeni kazanılan rozetin etiketi. */
QLabel[role="new-tag"] {
    background-color: @accent@;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 1px 6px;
    font-size: 9px;
    font-weight: 800;
}

/* Küçük bilgi çipi (sınav başlangıç kartı). */
QPushButton[variant="chip"], QPushButton[variant="chip-accent"] {
    background-color: @surface_alt@;
    color: @text_muted@;
    border: none;
    border-radius: 11px;
    padding: 4px 11px;
    min-height: 0px;
    font-size: 12px;
    font-weight: 700;
}

QPushButton[variant="chip-accent"] {
    background-color: @accent_soft@;
    color: @accent@;
}

/* Yol düğmesi kendisi çiziyor (widgets/path_node.py). */
QPushButton[variant="node-painted"],
QPushButton[variant="node-painted"]:hover,
QPushButton[variant="node-painted"]:pressed,
QPushButton[variant="node-painted"]:disabled {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0px;
}

QPushButton[variant="node"] {
    min-width: 74px; max-width: 74px;
    min-height: 74px; max-height: 74px;
    border-radius: 40px;
    font-size: @font_xxl@px;
    font-weight: 700;
    padding: 0;
    border: 3px solid transparent;
}

QPushButton[variant="node"][state="completed"] {
    background-color: @success@;
    color: #FFFFFF;
}

QPushButton[variant="node"][state="current"] {
    background-color: @accent@;
    color: #FFFFFF;
    border-color: @accent_soft@;
}

QPushButton[variant="node"][state="in_progress"] {
    background-color: @warning@;
    color: #FFFFFF;
}

/* Henüz yazılmamış bölüm: kesik çerçeve, soluk. Tıklanmadığı için de
   `:disabled` görünümü almasın diye rengi burada açıkça veriliyor. */
QPushButton[variant="node"][state="planned"] {
    background-color: transparent;
    color: @text_muted@;
    border: 2px dashed @border@;
    border-radius: 39px;
}

/* Kilitli bölüm: yazılmış ama önündeki bölüm bitmediği için açılmıyor.
 * Görünüşü "yakında"ya benziyor, çünkü ikisi de tıklanmıyor; farkı
 * altındaki açıklama söylüyor. */
QPushButton[variant="node"][state="locked"] {
    background-color: @surface_alt@;
    border: 2px solid @border@;
    border-radius: 39px;
}

QPushButton[variant="node"][state="planned"]:disabled {
    background-color: transparent;
    color: @text_muted@;
    border: 2px dashed @border@;
    border-radius: 39px;
}

QLabel[role="heading"][muted="true"] {
    color: @text_muted@;
}
/* Kilitli bölüm: ad ve alt yazı soluk (prototip `.pnode.locked`, %55). */
QLabel[role="heading"][locked="true"] { color: @text_faint@; }
QLabel[role="muted"][locked="true"] { color: @text_faint@; }

QPushButton[variant="node"][state="not_started"] {
    background-color: @surface_alt@;
    color: @text_muted@;
    border-color: @border@;
}

QPushButton[variant="node"]:hover { border-color: @accent@; }

/* Halkaları birleştiren eğri `journey_view.PathConnector` içinde çiziliyor;
 * renkleri paletten (`border`, tamamlananlarda `success`). */

/* Modül kartı.
 * QPushButton kullanılmıyor: genel düğme kuralındaki `min-height` widget'a
 * Python'dan verilen en küçük yüksekliği eziyor ve kart eziliyordu. Tıklama
 * QFrame üzerinde yakalanıyor. */
QFrame[variant="module"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
    min-height: 150px;
}

/* Üzerine gelme çerçevesi GlowCard'da çiziliyor (geçişli, patika renginde). */

/* Karşılama kartı: vurgu renginden ikinci renge geçiş */
/* Ayarlar penceresi: solda kategoriler, sağda gruplanmış ayarlar. */
QFrame[role="settings-sidebar"] {
    background-color: @bg@;
    border: none;
    border-right: 1px solid @border@;
    border-top-left-radius: 21px;
    border-bottom-left-radius: 21px;
}

QPushButton[variant="settings-nav"] {
    text-align: left;
    padding: 9px 12px;
    border: none;
    border-radius: @radius_sm@px;
    background-color: transparent;
    color: @text_muted@;
    font-size: @font_sm@px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton[variant="settings-nav"]:hover { background-color: @surface_hover@; color: @text@; }

/* Seçili kategorinin zemini NavIndicator'da (kayan). */
QPushButton[variant="settings-nav"][active="true"] {
    background-color: transparent;
    color: @text@;
}

QPushButton[variant="settings-nav"][active="true"]:hover { background-color: transparent; }

QFrame[role="settings-group"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 14px;
}

/* Karşılama kartının zemini ve daireleri `HeroCard.paintEvent` içinde
 * çiziliyor; burada yalnızca stilin kendi zeminini kapatıyoruz. */
QFrame[role="hero"] {
    border: none;
    background-color: transparent;
}

/* --- Metin girişleri ------------------------------------------------------ */

/* Giriş kutusunun zemini kendi rengi (`field`), yüzey rengi değil.
 *
 * Önce `surface` yazıyordu; kutu bir kartın üzerine düştüğünde kartla
 * birebir aynı renk oluyordu (ΔE 0.0) ve geriye yalnızca kenarlık kalıp
 * alan bir kutudan çok delik gibi görünüyordu. `field` her iki temada da
 * hem sayfa zemininden hem kart zemininden ayrılacak şekilde seçildi. */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: @field@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_md@px;
    padding: 10px 13px;
    selection-background-color: @accent@;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QComboBox:focus { border-color: @accent@; }

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: @surface_alt@;
    color: @text_muted@;
}

QTextEdit[role="code"] {
    background-color: @code_bg@;
    font-family: @font_mono@;
    font-size: @font_sm@px;
    border: none;
    border-radius: 0;
    padding: @space_md@px;
}

QPlainTextEdit[role="output"] {
    background-color: @code_bg@;
    font-family: @font_mono@;
    font-size: @font_xs@px;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_sm@px @space_md@px;
}

QComboBox::drop-down { border: none; width: 28px; }

QComboBox QAbstractItemView {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_xs@px;
    selection-background-color: @accent_soft@;
    selection-color: @accent@;
}

/* --- Ders metni ----------------------------------------------------------- */

/* İç boşluk sıfır: metnin çevresindeki boşluğu yerleşim yönetiyor. İkisi
 * birden boşluk verirse genişlik tahmin edilemez hâle geliyor. */
QTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0px;
    font-size: @font_md@px;
}

/* --- Sınav seçenekleri ---------------------------------------------------- */

QRadioButton, QCheckBox {
    spacing: 11px;
    padding: 11px 13px;
    border-radius: @radius_md@px;
    background-color: transparent;
    font-size: @font_sm@px;
}

QRadioButton:hover, QCheckBox:hover { background-color: @surface_hover@; }

QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @border_strong@;
    background-color: @surface@;
}

QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    border-color: @accent@;
    background-color: @accent@;
}

QRadioButton[tone="success"], QCheckBox[tone="success"] {
    background-color: @success_soft@;
    color: @success@;
}

QRadioButton[tone="danger"], QCheckBox[tone="danger"] {
    background-color: @danger_soft@;
    color: @danger@;
}

/* Sınav şıkkı: sonuçta zemin satırın tamamında, düğme saydam kalıyor. */
QWidget[role="option-row"] {
    background-color: transparent;
    border-radius: @radius_md@px;
}
QWidget[role="option-row"][tone="success"] { background-color: @success_soft@; }
QWidget[role="option-row"][tone="danger"] { background-color: @danger_soft@; }
QWidget[role="option-row"] QRadioButton[tone="success"],
QWidget[role="option-row"] QRadioButton[tone="danger"] { background-color: transparent; }

/* --- İlerleme çubuğu ------------------------------------------------------ */

QProgressBar {
    background-color: @border@;
    border: none;
    border-radius: 4px;
    max-height: 7px;
    min-height: 7px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk { background-color: @accent@; border-radius: 4px; }

/* --- Geri bildirim şeritleri ---------------------------------------------- */

QFrame[banner="success"] {
    background-color: @success_soft@;
    border: 1px solid @success@;
    border-radius: @radius_md@px;
}

QFrame[banner="danger"] {
    background-color: @danger_soft@;
    border: 1px solid @danger@;
    border-radius: @radius_md@px;
}

QFrame[banner="warning"] {
    background-color: @warning_soft@;
    border: 1px solid @warning@;
    border-radius: @radius_md@px;
}

QFrame[banner="accent"] {
    background-color: @accent_soft@;
    border: none;
    border-left: 3px solid @accent@;
    border-radius: @radius_sm@px;
}

/* Sınav açıklaması: ampullü, dolgulu, dört köşesi yuvarlak; kenar çizgisi
 * yok. Soru kartının içinde durduğu için çizgi kartın kenarlığıyla
 * yarışıyordu. */
QFrame[banner="tip"] {
    background-color: @accent_soft@;
    border: none;
    border-radius: @radius_md@px;
}

/* Kontrol sonucu satırları: kenarlık yok, yalnızca yumuşak zemin */
QFrame[check="passed"] {
    background-color: @success_soft@;
    border: none;
    border-radius: @radius_md@px;
}

QFrame[check="failed"] {
    background-color: @danger_soft@;
    border: none;
    border-radius: @radius_md@px;
}

/* --- Notlarım ------------------------------------------------------------- */

/* Sol sütun sayfanın kendi zemininde; okuma alanından yalnızca ince bir
 * çizgiyle ayrılıyor. Önce `surface_alt` idi ve şeritle sayfa arasında
 * üçüncü bir renk bandı gibi durup düzeni bölüyordu (Alican bildirdi). */
QFrame[role="notebook-side"] {
    background-color: @bg@;
    border: none;
    border-right: 1px solid @border@;
}

/* `show-decoration-selected: 0`: seçim girinti alanına taşmasın; taşınca
 * notun solunda ince bir vurgu çizgisi kalıyordu. */
QTreeWidget[role="notebook-tree"] {
    background-color: transparent;
    border: none;
    outline: none;
    font-size: @font_sm@px;
    show-decoration-selected: 0;
}

QTreeWidget[role="notebook-tree"]::item {
    padding: 7px 6px;
    border-radius: @radius_sm@px;
    color: @text@;
}

QTreeWidget[role="notebook-tree"]::item:hover { background-color: @surface_hover@; }

QTreeWidget[role="notebook-tree"]::item:selected {
    background-color: @accent_soft@;
    color: @accent@;
}

QTreeWidget[role="notebook-tree"]::branch,
QTreeWidget[role="notebook-tree"]::branch:selected { background: transparent; }

/* Notun adı: kutu değil, başlık gibi; altındaki çizgi yazılabildiğini
 * söylüyor. */
QLineEdit[role="note-title"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border@;
    border-radius: 0;
    padding: 8px 2px;
    font-size: @font_xl@px;
    font-weight: 700;
}

QLineEdit[role="note-title"]:focus { border-bottom-color: @accent@; }

QLineEdit[role="note-title"][compact="true"] { font-size: @font_lg@px; }

/* Bölüm ekranının sağındaki not paneli: sayfanın zemininde, içerikten ince
 * bir çizgiyle ayrılıyor (Notlarım'ın sol sütunu gibi). */
QFrame[role="note-panel"] {
    background-color: @surface@;
    border: 1px solid @border_strong@;
    border-radius: 20px;
}
QFrame[role="drawer-head"] {
    background: transparent;
    border: none;
    border-bottom: 1px solid @border@;
    border-radius: 0;
}
QFrame[role="drawer-foot"] {
    background: transparent;
    border: none;
    border-top: 1px solid @border@;
    border-radius: 0;
}
QLabel[role="drawer-title"] { font-weight: 700; color: @text@; }
QLabel[role="drawer-sub"] { font-size: 12.5px; color: @text_muted@; }
QLabel[role="drawer-saved"] { font-size: 12px; color: @success@; }
QPushButton[variant="round"] {
    background: transparent;
    border: none;
    border-radius: 14px;
    padding: 0;
    min-height: 0px;
}
QPushButton[variant="round"]:hover { background-color: @surface_hover@; }
QPushButton[size="sm"] {
    min-height: 0px;
    padding: 6px 12px;
    font-size: 12.5px;
    border-radius: 9px;
}

QTextEdit[role="note-editor"] {
    padding: @space_md@px;
    font-size: @font_md@px;
}
/* Not çekmecesinde yazı alanı çerçevesiz (prototip `.drawer textarea`). */
QTextEdit[role="note-editor"][drawer="true"],
QTextEdit[role="note-editor"][drawer="true"]:focus {
    background: transparent;
    border: none;
    padding: 6px 2px;
    font-size: 15px;
}

/* Araç çubuğu düğmeleri: küçük, metinli. Kod düğmesinin menü oku metnin
 * içinde ("Kod ▾"); Qt'nin kendi oku düğmenin kenarına yapışıyordu. */
QPushButton[variant="tool"] {
    padding: 5px 12px;
    font-size: @font_xs@px;
    font-weight: 600;
    border-radius: @radius_sm@px;
}

QPushButton[variant="tool"]::menu-indicator { image: none; width: 0px; }

/* Seçili araç (çalışma kâğıdında kalem / silgi). */
QPushButton[variant="tool"][active="true"] {
    background-color: @accent_soft@;
    border-color: @accent@;
    color: @accent@;
}

/* Çalışma kâğıdının sembol paleti. Yazı tipi kodda veriliyor (Cambria Math);
   burada yalnızca kutu. Seçili sembol kâğıda konmayı bekliyor. */
QPushButton[variant="symbol"] {
    padding: 0px 4px;
    /* Yükseklik burada: QSS `min-height`, koddaki setFixedHeight'ı eziyor
       (genel düğmenin 20 pikseli düğmeleri yassı bırakıyordu). */
    min-height: 36px;
    max-height: 36px;
    border-radius: @radius_sm@px;
    background-color: @surface@;
    color: @text@;
    font-family: "Cambria Math", "Segoe UI Symbol";
    font-size: 19px;
    font-weight: 400;
}

/* Uzun ifadeler (log₂, ln 2.5) iki sütunlu özel bölümde; biraz küçük. */
QPushButton[variant="symbol"][long="true"] {
    font-size: 15px;
}

QPushButton[variant="symbol"]:hover {
    border-color: @accent@;
    background-color: @surface_hover@;
}

QPushButton[variant="symbol"][active="true"] {
    background-color: @accent@;
    border-color: @accent@;
    color: #FFFFFF;
}

/* Kısayol listesindeki tuş rozeti: klavye tuşu gibi, altı bir piksel kalın.
   Arayüz yazı tipiyle: kod yazı tipi (Consolas) küçük boyutta sıkışık ve
   inceydi, tuş adları kod değil (Alican "çok kötü" dedi). */
QLabel[role="key"] {
    background-color: @field@;
    border: 1px solid @border_strong@;
    border-bottom-width: 2px;
    border-radius: @radius_xs@px;
    padding: 2px 8px;
    min-width: 12px;
    font-family: @font_ui@;
    font-size: @font_xs@px;
    font-weight: 600;
    color: @text@;
}

/* Kısayol grupları: küçük harfli başlıkta `eyebrow`'un geniş harf aralığı
   dağınık duruyordu. */
QLabel[role="shortcut-group"] {
    font-size: @font_xs@px;
    font-weight: 650;
    color: @text_muted@;
}

/* --- Genel arama (Ctrl+K) ------------------------------------------------- */

QFrame[role="search-card"] {
    background-color: @surface@;
    border: 1px solid @border_strong@;
    border-radius: 20px;
}

/* Kutu değil, kartın içine yazılan büyük bir satır. */
QLineEdit[role="search-field"] {
    background-color: transparent;
    border: none;
    padding: 4px 0;
    font-size: 17px;
}

QLineEdit[role="search-field"]:focus { border: none; }

QListWidget[role="search-results"] {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px 0;
}

QFrame[role="search-hint"] {
    background: transparent;
    border: none;
    border-top: 1px solid @border@;
}
QLabel[role="search-hint-text"] { color: @text_muted@; font-size: 12px; }

/* --- Kaydırma çubukları --------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @border_strong@;
    border-radius: 6px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover { background: @text_muted@; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @border_strong@;
    border-radius: 6px;
    min-width: 40px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover { background: @text_muted@; }

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0; width: 0; border: none; background: none;
}

QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Ayırıcı kollar ------------------------------------------------------- */

QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal { width: @space_sm@px; }
QSplitter::handle:vertical { height: @space_sm@px; }
QSplitter::handle:hover { background-color: @border@; }

/* --- İpucu balonu ve menü ------------------------------------------------- */

QToolTip {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_sm@px;
    padding: 8px 10px;
    font-size: @font_sm@px;
}

QMenu {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_xs@px;
}

QMenu::item { padding: 8px 20px 8px 14px; border-radius: @radius_sm@px; }
QMenu::item:selected { background-color: @accent_soft@; color: @accent@; }
QMenu::separator { height: 1px; background-color: @border@; margin: @space_xs@px 0; }

/* --- Alt şerit düğmeleri ve açılır paneller ------------------------------ */

/* Genel `QPushButton` kuralı 11px/21px iç boşluk ve 20px en az yükseklik
   veriyor; sıfırlanmazsa 18 piksellik düğme 43 piksele çıkıyor ve alt şerit
   iki katına kalınlaşıyordu (25 -> 51 px, ölçüldü). */
QPushButton[variant="footer-icon"] {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-height: 0px;
    min-width: 0px;
}
QPushButton[variant="footer-icon"]:hover {
    background-color: @surface_alt@;
    border-radius: @radius_sm@px;
}

/* Sol alttaki GitHub yıldızı: telif yazısıyla aynı boyda, üstüne gelince
   belirginleşiyor. */
QPushButton[variant="footer-star"] {
    background-color: transparent;
    border: none;
    color: @text_muted@;
    font-size: @font_sm@px;
    font-weight: 600;
    padding: 1px 6px;
    min-height: 0px;
    min-width: 0px;
}
QPushButton[variant="footer-star"]:hover {
    background-color: @surface_alt@;
    color: @text@;
    border-radius: @radius_sm@px;
}

QLabel[role="popover-title"] {
    font-size: @font_lg@px;
    font-weight: bold;
}
QLabel[role="popover-text"] {
    font-size: @font_sm@px;
}

/* Patika kartı (prototip `.tcard`). Üzerine gelme çerçevesi ve ışıma GlowCard'da. */
QFrame[variant="track"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 20px;
}
QFrame[variant="track"][locked="true"] {
    background-color: @surface_dim@;
    border: 1px dashed @border_strong@;
}
QLabel[role="track-title"] {
    font-family: @font_display@;
    font-size: 17px;
    font-weight: 700;
    color: @text@;
}
QFrame[locked="true"] QLabel[role="track-title"] { color: @text_muted@; }
QLabel[role="track-sub"] { font-size: 11.5px; font-weight: 600; color: @text_muted@; }
QLabel[role="track-desc"] { font-size: 13px; color: @text_muted@; }
QFrame[locked="true"] QLabel[role="track-desc"] { color: @text_faint@; }
QLabel[role="track-meta"] { font-size: 12px; color: @text_muted@; }
QLabel[role="track-why"] { font-size: 12px; color: @text_faint@; }
QLabel[role="lock-chip"] {
    background-color: @surface_alt@;
    border-radius: 10px;
}

/* Sınav kartları (prototip `.qcard`). */
QFrame[surface="card"][variant="qcard"] { border-radius: 24px; }
QLabel[role="qcard-title"] {
    font-family: @font_display@;
    font-size: 20px;
    font-weight: 700;
    color: @text@;
}
QLabel[role="question"] {
    font-family: @font_display@;
    font-size: 18px;
    font-weight: 600;
    color: @text@;
}
QLabel[role="qtime"] {
    font-family: @font_mono@;
    font-size: 13px;
    font-weight: 700;
}
QFrame[role="qwhy"] {
    background-color: @surface_alt@;
    border-radius: 12px;
}
QLabel[role="qwhy-text"] { font-size: 13.5px; color: @text_muted@; }

/* Alıştırma editörü kartı (prototip `.editor`). */
QFrame[role="editor-card"] {
    background-color: @code_bg@;
    border: 1px solid @border@;
    border-radius: 16px;
}
QTextEdit[role="code"][card="true"] {
    background-color: transparent;
    padding: 8px 8px 8px 0;
}
/* Tuş kutucuğu (prototip `kbd`). */
QLabel[role="kbd"] {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 6px;
    border: 1px solid @border_strong@;
    border-bottom-width: 2px;
    background-color: @surface@;
    color: @text@;
    min-height: 0px;
    max-height: 22px;
}

/* Boş durum (prototip `.empty`). */
QLabel[role="empty-title"] { font-family: @font_display@; font-size: 18px; font-weight: 700; color: @text@; }
QLabel[role="empty-text"] { font-size: 14px; color: @text_muted@; }

/* Ayarlar kip penceresi yazıları (prototip `.mside`, `.mpage`, `.srow`). */
QLabel[role="modal-title"] { font-family: @font_display@; font-size: 18px; font-weight: 700; color: @text@; }
QLabel[role="modal-version"] { font-size: 12px; color: @text_faint@; }
QLabel[role="modal-page-title"] { font-family: @font_display@; font-size: 22px; font-weight: 700; color: @text@; }
QLabel[role="modal-page-desc"] { font-size: 13.5px; color: @text_muted@; }
QLabel[role="srow-title"] { font-size: 14px; font-weight: 700; color: @text@; }
QLabel[role="srow-desc"] { font-size: 12.5px; color: @text_muted@; }

/* Profil (prototip `.pcard`, `.bwall`). */
QLabel[role="pcard-name"] { font-family: @font_display@; font-size: 22px; font-weight: 700; color: @text@; }
QLabel[role="pcard-since"] { font-size: 13px; color: @text_muted@; }
QLabel[role="pcard-percent"] { font-size: 13px; font-weight: 700; color: @text@; }
QFrame[role="mini"] { background-color: @surface_alt@; border: none; border-radius: 12px; }
QLabel[role="mini-value"] { font-family: @font_display@; font-size: 18px; font-weight: 700; color: @text@; }
QLabel[role="mini-label"] { font-size: 11.5px; color: @text_muted@; }
QLabel[role="card-head"] { font-family: @font_display@; font-size: 15px; font-weight: 700; color: @text@; }
QLabel[role="count-chip"] {
    background-color: @accent_soft@; color: @accent@;
    font-size: 11.5px; font-weight: 700; padding: 3px 10px; border-radius: 10px;
}
QPushButton[variant="round-nav"] {
    background: transparent; border: 1px solid @border@; border-radius: 17px;
    min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px; padding: 0;
}
QPushButton[variant="round-nav"]:hover { background-color: @surface_hover@; }
