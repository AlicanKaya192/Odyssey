/* Uygulamanın tek stil dosyası.
 *
 * Buradaki yer tutucular (at işaretiyle sarılmış isimler) app/core/theme.py
 * tarafından, seçili temanın belirteçleriyle doldurulur. Widget'ların içine
 * dağınık stil yazılmaz.
 *
 * Qt'nin stil dosyaları gölge desteklemiyor; gölgeler
 * app/widgets/effects.py içindeki yardımcıyla veriliyor.
 */

/* --- Genel ---------------------------------------------------------------- */

QWidget {
    background-color: @bg@;
    color: @text@;
    font-family: @font_ui@;
    font-size: @font_md@px;
}

QMainWindow, QDialog { background-color: @bg@; }
QWidget:disabled { color: @text_muted@; }

/* Etiketler kendi zeminini taşımamalı; farklı renkteki bir yüzeyin üzerinde
 * arkalarında uyumsuz dikdörtgen görünüyor. */
QLabel { background-color: transparent; }

QFrame[role="divider"] {
    background-color: @border@;
    border: none;
    max-height: 1px;
}

QScrollArea, QScrollArea > QWidget > QWidget { background-color: transparent; }

/* --- Yüzeyler ------------------------------------------------------------- */

QFrame[surface="card"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
}

QFrame[surface="plain"] {
    background-color: @surface@;
    border: none;
}

QFrame[surface="alt"] {
    background-color: @surface_alt@;
    border: none;
}

QFrame[role="separator"] {
    background-color: @border@;
    max-height: 1px;
    border: none;
}

/* --- Sol ikon şeridi ------------------------------------------------------ */

/* Her ekranın altındaki telif şeridi. Sayfanın parçası gibi durması için
 * kendi zemini yok; yalnızca ince bir çizgiyle içerikten ayrılıyor. */
QFrame[role="footer"] {
    background-color: transparent;
    border: none;
    border-top: 1px solid @border@;
}

QLabel[role="footnote"] {
    color: @text_muted@;
    font-size: @font_xs@px;
}

QFrame[role="rail"] {
    background-color: @rail_bg@;
    border: none;
    border-right: 1px solid @border@;
}

QPushButton[variant="rail"] {
    background-color: transparent;
    border: none;
    border-radius: @radius_lg@px;
    padding: 0;
    min-width: 52px;
    max-width: 52px;
    min-height: 50px;
    max-height: 50px;
    font-size: @font_xl@px;
    color: @text_muted@;
}

QPushButton[variant="rail"]:hover { background-color: @surface_hover@; }

QPushButton[variant="rail"][active="true"] {
    background-color: @accent_soft@;
    color: @accent@;
}


/* --- Üst şerit ------------------------------------------------------------ */

/* Şerit sayfayla aynı zeminde duruyor. Ayrı bir yüzey rengi verildiğinde
   üstte kopuk bir blok gibi görünüyordu; alttaki ince çizgi ayrımı zaten
   yeterince yapıyor. */
QFrame[role="topbar"] {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid @border@;
}

/* --- Segmented control ---------------------------------------------------- */

/* Kutu yok. Şerit sayfayla aynı zemine geçince dolu gri kutu üstte
   yamalı duruyordu; seçili sekmeyi alttaki çizgi belli ediyor. */
QFrame[role="segment-group"] {
    background-color: transparent;
    border: none;
}

QPushButton[variant="segment"] {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 0;
    padding: 9px 4px;
    font-size: @font_sm@px;
    font-weight: 600;
    color: @text_muted@;
}

QPushButton[variant="segment"]:hover { color: @text@; }

QFrame[role="segmented"] {
    background-color: @surface_alt@;
    border: 1px solid @border@;
    border-radius: @radius_sm@px;
}

QPushButton[variant="pill"] {
    background-color: transparent;
    border: none;
    border-radius: @radius_xs@px;
    padding: 5px 14px;
    font-size: @font_sm@px;
    font-weight: 650;
    color: @text_muted@;
}

QPushButton[variant="pill"]:hover { color: @text@; }

QPushButton[variant="pill"][active="true"] {
    background-color: @accent@;
    color: @text_inverse@;
}

QPushButton[variant="segment"][active="true"] {
    color: @text@;
    border-bottom: 2px solid @accent@;
}

/* --- Başlıklar ve metin --------------------------------------------------- */

QLabel[role="display"] {
    font-size: @font_display@px;
    font-weight: 700;
    color: @text@;
}

QLabel[role="title"] {
    font-size: @font_xxl@px;
    font-weight: 700;
    color: @text@;
}

QLabel[role="subtitle"] {
    font-size: @font_lg@px;
    font-weight: 650;
    color: @text@;
}

QLabel[role="heading"] {
    font-size: @font_md@px;
    font-weight: 650;
    color: @text@;
}

QLabel[role="muted"] {
    color: @text_muted@;
    font-size: @font_sm@px;
}

/* Başlık şeridindeki bağlam satırı: küçük, aralıklı, vurgu renginde.
   Rengi Python'dan veriliyor çünkü ekrana göre değişiyor. */
QLabel[role="eyebrow"] {
    font-size: 12px;
    font-weight: 750;
    letter-spacing: 1.4px;
}

/* Ekran adı. Boyutu ve ağırlığı Python'dan veriliyor; burada yalnızca
   renk ve harf aralığı ayarlanıyor. */
QLabel[role="screen"] {
    font-size: 26px;
    font-weight: 700;
    color: @text@;
    letter-spacing: -.3px;
}

QLabel[role="section"] {
    color: @text_muted@;
    font-size: @font_xs@px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel[role="chip"] {
    background-color: @surface_alt@;
    color: @text_muted@;
    border-radius: @radius_pill@px;
    padding: 5px 12px;
    font-size: @font_xs@px;
    font-weight: 650;
}

QLabel[role="chip"][tone="success"] {
    background-color: @success_soft@;
    color: @success@;
}

QLabel[role="chip"][tone="warning"] {
    background-color: @warning_soft@;
    color: @warning@;
}

QLabel[role="chip"][tone="accent"] {
    background-color: @accent_soft@;
    color: @accent@;
}

QLabel[tone="success"] { color: @success@; }
QLabel[tone="danger"]  { color: @danger@; }
QLabel[tone="warning"] { color: @warning@; }
QLabel[tone="accent"]  { color: @accent@; }
QLabel[tone="inverse"] { color: #FFFFFF; }

/* --- Düğmeler ------------------------------------------------------------- */

QPushButton {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_md@px;
    padding: 11px 21px;
    font-size: @font_sm@px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover  { background-color: @surface_hover@; }
QPushButton:pressed { background-color: @surface_alt@; }

QPushButton:disabled {
    color: @text_muted@;
    border-color: @border@;
    background-color: @surface_alt@;
}

QPushButton[variant="primary"] {
    background-color: @accent@;
    color: #FFFFFF;
    border: 1px solid @accent@;
}

QPushButton[variant="primary"]:hover {
    background-color: @accent_hover@;
    border-color: @accent_hover@;
}

QPushButton[variant="primary"]:disabled {
    background-color: @surface_alt@;
    border-color: @border@;
    color: @text_muted@;
}

/* Geri dönüşü olmayan eylemin düğmesi. Vurgu renginden ayrı bir renk
 * kullanılıyor: "birincil" ile "tehlikeli" aynı görünürse insan ikisini
 * ayırt etmeden basıyor. */
QPushButton[variant="danger"] {
    background-color: @danger@;
    color: #FFFFFF;
    border: 1px solid @danger@;
}

QPushButton[variant="danger"]:hover {
    background-color: @danger_hover@;
    border-color: @danger_hover@;
}

QLabel[role="dialog-title"] {
    font-size: @font_lg@px;
    font-weight: 700;
    color: @text@;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border: 1px solid transparent;
    color: @text_muted@;
    padding: 8px 14px;
}

QPushButton[variant="ghost"]:hover {
    background-color: @surface_hover@;
    color: @text@;
}

QPushButton[variant="small"] {
    padding: 7px 14px;
    font-size: @font_xs@px;
}

/* Alıştırma numaraları. Sürüm notlarındaki sayfa düğmeleriyle aynı dili
   konuşuyorlar: seçili olan vurgu renginde dolu, diğerleri çerçeveli. */
QPushButton[variant="number"] {
    min-width: 30px;
    padding: 5px 9px;
    font-size: @font_xs@px;
    font-weight: 700;
    border-radius: @radius_sm@px;
}

QPushButton[variant="number"][active="true"] {
    background-color: @accent@;
    border-color: @accent@;
    color: #FFFFFF;
}

QPushButton[variant="number"][active="true"]:hover {
    background-color: @accent_hover@;
    border-color: @accent_hover@;
}

QPushButton:focus { outline: none; border-color: @accent@; }

/* Sayfa içi başlık listesi (sağ sütun) */
QPushButton[variant="toc"] {
    background-color: transparent;
    border: none;
    border-left: 2px solid @border@;
    border-radius: 0;
    padding: 7px 0 7px 14px;
    text-align: left;
    font-size: @font_sm@px;
    font-weight: 500;
    color: @text_muted@;
}

QPushButton[variant="toc"]:hover { color: @text@; }

QPushButton[variant="toc"][active="true"] {
    color: @accent@;
    border-left-color: @accent@;
    font-weight: 650;
}

/* Ders notu listesi (sol sütun) */
QPushButton[variant="listitem"] {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: @radius_md@px;
    padding: 12px 14px;
    text-align: left;
    font-size: @font_sm@px;
    font-weight: 500;
    color: @text@;
}

QPushButton[variant="listitem"]:hover { background-color: @surface_hover@; }

QPushButton[variant="listitem"][active="true"] {
    background-color: @surface@;
    border-color: @border@;
    font-weight: 650;
}

/* --- Öğrenme yolu düğümleri ----------------------------------------------- */

QPushButton[variant="node"] {
    min-width: 74px; max-width: 74px;
    min-height: 74px; max-height: 74px;
    border-radius: 37px;
    font-size: @font_xxl@px;
    font-weight: 700;
    padding: 0;
    border: 3px solid transparent;
}

QPushButton[variant="node"][state="completed"] {
    background-color: @success@;
    color: #FFFFFF;
}

QPushButton[variant="node"][state="current"] {
    background-color: @accent@;
    color: #FFFFFF;
    border-color: @accent_soft@;
}

QPushButton[variant="node"][state="in_progress"] {
    background-color: @warning@;
    color: #FFFFFF;
}

/* Henüz yazılmamış bölüm: kesik çerçeve, soluk. Tıklanmadığı için de
   `:disabled` görünümü almasın diye rengi burada açıkça veriliyor. */
QPushButton[variant="node"][state="planned"] {
    background-color: transparent;
    color: @text_muted@;
    border: 2px dashed @border@;
}

/* Kilitli bölüm: yazılmış ama önündeki bölüm bitmediği için açılmıyor.
 * Görünüşü "yakında"ya benziyor, çünkü ikisi de tıklanmıyor; farkı
 * altındaki açıklama söylüyor. */
QPushButton[variant="node"][state="locked"] {
    background-color: @surface_alt@;
    border: 2px solid @border@;
}

QPushButton[variant="node"][state="planned"]:disabled {
    background-color: transparent;
    color: @text_muted@;
    border: 2px dashed @border@;
}

QLabel[role="heading"][muted="true"] {
    color: @text_muted@;
}

QPushButton[variant="node"][state="not_started"] {
    background-color: @surface_alt@;
    color: @text_muted@;
    border-color: @border@;
}

QPushButton[variant="node"]:hover { border-color: @accent@; }

QFrame[role="connector"] {
    background-color: @border@;
    border: none;
    border-radius: 2px;
    max-width: 4px;
    min-width: 4px;
}

QFrame[role="connector"][done="true"] { background-color: @success@; }

/* Modül kartı.
 * QPushButton kullanılmıyor: genel düğme kuralındaki `min-height` widget'a
 * Python'dan verilen en küçük yüksekliği eziyor ve kart eziliyordu. Tıklama
 * QFrame üzerinde yakalanıyor. */
QFrame[variant="module"] {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_lg@px;
    min-height: 150px;
}

QFrame[variant="module"]:hover { border-color: @accent@; }

/* Karşılama kartı: vurgu renginden ikinci renge geçiş */
QFrame[role="hero"] {
    border: none;
    border-radius: @radius_xl@px;
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 @accent@, stop:1 @accent_second@
    );
}

/* --- Metin girişleri ------------------------------------------------------ */

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_md@px;
    padding: 10px 13px;
    selection-background-color: @accent@;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus,
QSpinBox:focus, QComboBox:focus { border-color: @accent@; }

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: @surface_alt@;
    color: @text_muted@;
}

QTextEdit[role="code"] {
    background-color: @code_bg@;
    font-family: @font_mono@;
    font-size: @font_sm@px;
    border: none;
    border-radius: 0;
    padding: @space_md@px;
}

QPlainTextEdit[role="output"] {
    background-color: @code_bg@;
    font-family: @font_mono@;
    font-size: @font_xs@px;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_sm@px @space_md@px;
}

QComboBox::drop-down { border: none; width: 28px; }

QComboBox QAbstractItemView {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_xs@px;
    selection-background-color: @accent_soft@;
    selection-color: @accent@;
}

/* --- Ders metni ----------------------------------------------------------- */

/* İç boşluk sıfır: metnin çevresindeki boşluğu yerleşim yönetiyor. İkisi
 * birden boşluk verirse genişlik tahmin edilemez hâle geliyor. */
QTextBrowser {
    background-color: transparent;
    border: none;
    padding: 0px;
    font-size: @font_md@px;
}

/* --- Sınav seçenekleri ---------------------------------------------------- */

QRadioButton, QCheckBox {
    spacing: 11px;
    padding: 11px 13px;
    border-radius: @radius_md@px;
    background-color: transparent;
    font-size: @font_sm@px;
}

QRadioButton:hover, QCheckBox:hover { background-color: @surface_hover@; }

QRadioButton::indicator, QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid @border_strong@;
    background-color: @surface@;
}

QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator { border-radius: 5px; }

QRadioButton::indicator:checked, QCheckBox::indicator:checked {
    border-color: @accent@;
    background-color: @accent@;
}

QRadioButton[tone="success"], QCheckBox[tone="success"] {
    background-color: @success_soft@;
    color: @success@;
}

QRadioButton[tone="danger"], QCheckBox[tone="danger"] {
    background-color: @danger_soft@;
    color: @danger@;
}

/* --- İlerleme çubuğu ------------------------------------------------------ */

QProgressBar {
    background-color: @border@;
    border: none;
    border-radius: 4px;
    max-height: 7px;
    min-height: 7px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk { background-color: @accent@; border-radius: 4px; }

/* --- Geri bildirim şeritleri ---------------------------------------------- */

QFrame[banner="success"] {
    background-color: @success_soft@;
    border: 1px solid @success@;
    border-radius: @radius_md@px;
}

QFrame[banner="danger"] {
    background-color: @danger_soft@;
    border: 1px solid @danger@;
    border-radius: @radius_md@px;
}

QFrame[banner="warning"] {
    background-color: @warning_soft@;
    border: 1px solid @warning@;
    border-radius: @radius_md@px;
}

QFrame[banner="accent"] {
    background-color: @accent_soft@;
    border: none;
    border-left: 3px solid @accent@;
    border-radius: @radius_sm@px;
}

/* Kontrol sonucu satırları: kenarlık yok, yalnızca yumuşak zemin */
QFrame[check="passed"] {
    background-color: @success_soft@;
    border: none;
    border-radius: @radius_md@px;
}

QFrame[check="failed"] {
    background-color: @danger_soft@;
    border: none;
    border-radius: @radius_md@px;
}

/* --- Kaydırma çubukları --------------------------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: @border_strong@;
    border-radius: 6px;
    min-height: 40px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover { background: @text_muted@; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: @border_strong@;
    border-radius: 6px;
    min-width: 40px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover { background: @text_muted@; }

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0; width: 0; border: none; background: none;
}

QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Ayırıcı kollar ------------------------------------------------------- */

QSplitter::handle { background-color: transparent; }
QSplitter::handle:horizontal { width: @space_sm@px; }
QSplitter::handle:vertical { height: @space_sm@px; }
QSplitter::handle:hover { background-color: @border@; }

/* --- İpucu balonu ve menü ------------------------------------------------- */

QToolTip {
    background-color: @surface@;
    color: @text@;
    border: 1px solid @border_strong@;
    border-radius: @radius_sm@px;
    padding: 8px 10px;
    font-size: @font_sm@px;
}

QMenu {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: @radius_md@px;
    padding: @space_xs@px;
}

QMenu::item { padding: 8px 20px 8px 14px; border-radius: @radius_sm@px; }
QMenu::item:selected { background-color: @accent_soft@; color: @accent@; }
QMenu::separator { height: 1px; background-color: @border@; margin: @space_xs@px 0; }
