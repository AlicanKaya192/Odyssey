# The Docker track's .dockerignore exercise needs a real __pycache__ folder
# in the build context, so this one is kept in the repository.
!content/09-docker/05-onbellek-ve-dockerignore/exercises/pycache-everywhere/shapes/__pycache__/
!content/09-docker/05-onbellek-ve-dockerignore/exercises/pycache-everywhere/shapes/__pycache__/*.pyc
*.egg-info/
.pytest_cache/

